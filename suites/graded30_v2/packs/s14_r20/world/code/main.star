# Race-20 Starlark World (`s14_r20`, 45 Open Tasks, `w-forge-s14-r20`)
# Reproduces the Race-20 mechanics seen in the released open episodes:
#   * 6 tools: bag, addSelection (sets one line; 0 drops it), showItem (full card), messageShopper, huntListings (search), close (buy | no_order)
#   * huntListings style phrase: the marks ( ) , - . : ; | / of textText read as spaces, the first 6 words, AND over the analyzed terms, BM25 (term frequency, no length norm) with equal
#     scores in ascending listing id, top 1000; style category: the department's listings in ascending id (textText not read; phrase does
#     not read productDepartment); 7 rows from the cursor's offset (nextKey "kofo<offset>"), result_follow = "kofo<offset + 7>" while more rows remain
#   * cards are dicts; features_map and annotations only on showItem (split view)
#   * 2-message allowance (messageShopper cost 1, budget 2); no meter tool
#   * events: triggers first_add (first addSelection that leaves a line) | finish (first close); kinds price | stock;
#     everything not yet fired fires at the first close; the notice echoes on the next call as {fana, zekola}
#   * persona: 12 reveal frames; the shopper answers lists (no one-at-a-time reply); one off-need pool per task (no-preference, or
#     did-not-understand on dnu_default tasks)
#   * message credit: race 20's own told share by the place of the first need a message names (one PRNG draw per message; fit: runs/r20_forge/credit_model_r20.json)
#   * graded: every need revealed, every chain page and every ordered listing opened via showItem, one answer slot per fired-event bitmask

TEXT_INDEX = "jasu"
CATEGORY_INDEX = "nemogi"
BRAND_INDEX = "kojefe"
PAGE_ROWS = 7
TEXT_HITS_CAP = 1000  # the field's `all_matches` saturates at 1000
CURSOR = "kofo"
ALL_TERMS = True
TOKEN_FOLLOWS_LIVE = False
TROUBLE_REF = "UNRESOLVED"
TROUBLE_EMPTY = "NOTHING"
TOOLS = ["bag", "addSelection", "showItem", "messageShopper", "huntListings", "close"]

def start(envelope):
    params = envelope["params"]
    for name in TOOLS:
        set_cost(name, "steps", 1)
    set_budget("steps", params.get("step_budget", 35))
    msg_cap = params.get("message_budget", 2)
    set_cost("messageShopper", "messages", 1)
    set_budget("messages", msg_cap)
    state_set("message_budget", msg_cap)
    state_set("events", params.get("events", []))
    state_set("fired_idx", [])
    state_set("fired_step", [])
    state_set("pending", [])
    state_set("voiced", [])
    state_set("ov_price", {})
    state_set("gone", [])
    state_set("messages_used", 0)
    state_set("questions_used", 0)
    state_set("last_cart_step", 0)
    state_set("last_cart_sig", "")
    state_set("first_hold_step", 0)
    state_set("first_answer_step", 0)
    setup_shopper(params["bezifa"])
    state_set("credit_seed", rand_below(1000000007))  # the question-credit draws of this episode
    return None

def row_of(item_id):
    return catalog_get(item_id)

def eff_price(row):
    ov = state_get("ov_price", {})
    if row["id"] in ov:
        return ov[row["id"]]
    return row.get("price", 0)

def eff_stock(row):
    if row["id"] in state_get("gone", []):
        return False
    return row.get("in_stock")

def turn():
    return None

# ---------------------------------------------------------------- store events
def needs_target(event):
    return event["kind"] in ["stock", "price"]

def fire_one(i, item, step):
    # event i happens (to the held listing `item` when it needs one; None there: the event is void - consumed with no effect); its echo is queued for the next call
    events = state_get("events", [])
    event = events[i]
    ov = state_get("ov_price", {})
    gone = state_get("gone", [])
    price_to = None
    if item != None:
        row = row_of(item)
        if event["kind"] == "price":
            base = ov.get(item, row.get("price", 0))
            price_to = (base * event["pct"]) // 100  # the live store floors: 5282 -> 3274 at 62, 79 -> 116 at 147; two price events apply one after the other
            ov[item] = price_to
        elif event["kind"] == "stock":
            if item not in gone:
                gone.append(item)
    state_set("ov_price", ov)
    state_set("gone", gone)
    fired = state_get("fired_idx", [])
    fired.append(i)
    state_set("fired_idx", fired)
    fs = state_get("fired_step", [])
    fs.append([i, step])
    state_set("fired_step", fs)
    ledger_append({"situ": i, "item": item if needs_target(event) else None, "kind": event["kind"], "step": step, "price_to": price_to, "silent": not event.get("echo", False)})
    if event.get("echo", False) and (item != None):
        pend = state_get("pending", [])
        pend.append([step, i])
        state_set("pending", pend)

def fire_trigger(trigger):
    # first_add: at the first addSelection that leaves a line in the order list; after_reveal: at the first need revealed
    events = state_get("events", [])
    lines = basket_get()
    step = counters()["step"]
    for i in range(len(events)):
        if (i in state_get("fired_idx", [])) or (events[i].get("trigger", "finish") != trigger):
            continue
        item = None
        if len(lines) > 0:
            item = lines[0]["id"]
        if needs_target(events[i]) and (item == None):
            continue
        fire_one(i, item, step)

def step_fired(i):
    for p in state_get("fired_step", []):
        if p[0] == i:
            return p[1]
    return -1

def can_finish(order):
    events = state_get("events", [])
    if len(events) == 0:
        return {"observation": None, "ok": True}
    is_skip = (type(order) == "dict") and (order.get("kind") == "decline")
    step = counters()["step"]
    lines = basket_get()
    sentences = []
    for i in range(len(events)):
        event = events[i]
        if i in state_get("fired_idx", []):
            # field: an event that fired on the call right before the close (the first addSelection) is listed in the refusal - the only way a
            # silent first-hold event is voiced (t-242ebbede7 x6, t-2f630618f6 x16, t-565673e95f x6, t-97459bcff7 x6); an event a refused
            # close already listed is not listed again
            if (step_fired(i) == step - 1) and (i not in state_get("voiced", [])) and not (needs_target(event) and is_skip):
                sentences.append(event["sent"])
                state_set("voiced", state_get("voiced", []) + [i])
            continue
        # everything not yet fired fires at the first close
        if needs_target(event) and (is_skip or (len(lines) == 0)):
            # no held line to hit (no_order, or an empty order list): void - not in the refusal, never retried (field: 216 + 20 empty no_order
            # closes on t-054ca3060b go through; t-e793532b4c no_order with a line held x4: no refusal)
            fire_one(i, None, step)
            state_set("voiced", state_get("voiced", []) + [i])
            continue
        item = None
        if len(lines) > 0:
            item = lines[0]["id"]
        fire_one(i, item, step)
        sentences.append(event["sent"])
        state_set("voiced", state_get("voiced", []) + [i])
    if len(sentences) > 0:
        return {"observation": sentences, "ok": False}
    return {"observation": None, "ok": True}

def pending_wrap(result):
    pend = state_get("pending", [])
    step = counters()["step"]
    ready = [p for p in pend if p[0] < step]
    if ready:
        state_set("pending", [p for p in pend if p[0] >= step])
        events = state_get("events", [])
        return {"fana": result, "zekola": [events[p[1]]["sent"] for p in ready]}
    return result

# ---------------------------------------------------------------- tools
def desc_of(row):
    text = row.get("description")
    if type(text) != "string":
        return ""
    return text

def row_obj(row, full):
    out = {
        "brand": row.get("maker"),
        "class_path": row.get("category"),
        "id": row.get("id"),
        "price": eff_price(row),
        "ready": eff_stock(row),
        "seller": row.get("merchant"),
        "summary": desc_of(row),
        "title": row.get("title"),
    }
    if full:
        facts = row.get("facts")
        out["features_map"] = facts if type(facts) == "dict" else {}
        out["annotations"] = row.get("seller_notes_text")
    return out

QUERY_SPLIT = "(),-.:;|/"  # the marks the live store reads as spaces in the search words (fit: runs/r20_forge/search_fit_r20.json)
QUERY_WORDS = 6  # how many words it reads (0 = every word)

def clean_query(query):
    buf = ""
    for ch in query.elems():
        buf += " " if ch in QUERY_SPLIT else ch
    words = buf.split()
    if QUERY_WORDS > 0:
        words = words[:QUERY_WORDS]
    return " ".join(words)

def text_search_ids(query):
    query = clean_query(query)
    if query == "":
        return []
    found = search(TEXT_INDEX, query, {"all_terms": ALL_TERMS, "k": 1000})
    if found["ok"] == False:
        return []
    out = []
    # the live store ranks the listings that hold every analyzed word by BM25 (k1 > 0, b 0) and equal scores in ascending listing id -
    # the order the index returns
    for hit in found["hits"]:
        if row_of(hit["id"]) != None:
            out.append(hit["id"])
    return out[:TEXT_HITS_CAP]

def department_ids(dept):
    # the browse style: every listing of the department, ascending id (the department index holds the section name as one exact value)
    if dept == None:
        return []
    return DEPARTMENT_IDS.get(str(dept).lower(), [])

def count_key(query):
    return clean_query(query).lower()

def cursor_offset(key):
    # "kofo<digits>" -> the offset; no key or an empty one -> 0 (field: 62 calls with nextKey "" answer the first page); anything else -> -1
    if key == None:
        return 0
    key = str(key)
    if key == "":
        return 0
    if (not key.startswith(CURSOR)) or (len(key) == len(CURSOR)):
        return -1
    n = 0
    for ch in key[len(CURSOR):].elems():
        if ch not in "0123456789":
            return -1
        n = n * 10 + "0123456789".find(ch)
    return n

def tool_hunt_listings(args):
    lead = cursor_offset(args.get("nextKey"))
    if lead < 0:
        return {"fault": TROUBLE_REF}  # field: a nextKey that is no cursor of the store -> UNRESOLVED (405 calls)
    style = args.get("style")
    words = str(args.get("textText") or "").strip()
    ids = []
    count = 0
    if style == "category":
        # field: the department's listings in ascending id; textText is not read (771 distinct searches with and without one answer the same);
        # no department -> nothing
        dept = args.get("productDepartment")
        ids = department_ids(dept)
        count = len(ids)
        live = DEPARTMENT_LIVE_COUNT.get(str(dept).lower()) if dept != None else None
        if (live != None) and (live > count):
            count = live  # the live department holds listings no field page showed
    else:
        # field: the keyword search; productDepartment is not read (2,888 distinct searches with and without one answer the same); no words -> nothing
        ids = text_search_ids(words) if words != "" else []
        count = len(ids)
        live = LOCATE_LIVE_COUNT.get(count_key(words))
        if (live != None) and (live > count):
            count = live  # the live store holds listings no field page showed: the recorded `all_matches` of this search
    if count > TEXT_HITS_CAP:
        count = TEXT_HITS_CAP
    rows = ids[lead:lead + PAGE_ROWS]  # field: a cursor past the end answers no rows and no cursor (469 calls), not a fault
    # live: a cursor while offset + 7 < all_matches. The pack holds only listings some field page showed, so where the live count runs past
    # its own rows the cursor follows the live count only when TOKEN_FOLLOWS_LIVE (off: it never leads to a page the pack cannot fill)
    reach = count if TOKEN_FOLLOWS_LIVE else len(ids)
    follow = (CURSOR + str(lead + PAGE_ROWS)) if (lead + PAGE_ROWS < reach) else None
    return {"all_matches": count, "result_follow": follow, "rows": [row_obj(row_of(i), False) for i in rows]}

def tool_show_item(args):
    row = row_of(args.get("itemIdCode", ""))
    if row == None:
        return {"fault": TROUBLE_REF}  # field: an id the store does not hold -> UNRESOLVED (103 calls)
    return row_obj(row, True)

def line_qty(pid):
    for ln in basket_get():
        if ln["id"] == pid:
            return ln["quantity"]
    return 0

def bag_summary():
    lines_out = []
    total = 0
    for line in basket_get():
        row = row_of(line["id"])
        price = eff_price(row)
        total += price * line["quantity"]
        lines_out.append({"id": line["id"], "number": line["quantity"], "price": price, "title": row.get("title")})
    return {"bag": lines_out, "cart_running_total": total}

def tool_bag_list(args):
    return bag_summary()

def tool_add_selection(args):
    pid = args.get("whichId", "")
    if row_of(pid) == None:
        return {"fault": TROUBLE_REF}  # field: an id the store does not hold -> UNRESOLVED, the order list is unchanged
    amount = args.get("unitsTotal")
    if amount == None:
        amount = 0
    before = line_qty(pid)
    after = amount  # field: unitsTotal is the line's new quantity (37,354 of 37,354 answers); 0 drops the line
    if after != before:
        basket_set(pid, after)
    sig_parts = []
    for ln in basket_get():
        sig_parts.append(ln["id"] + ":" + str(ln["quantity"]))
    new_sig = ",".join(sorted(sig_parts))
    step = counters()["step"]
    prev_sig = state_get("last_cart_sig", "")
    if new_sig != prev_sig:
        state_set("last_cart_step", step)
        state_set("last_cart_sig", new_sig)
    first = (state_get("first_hold_step", 0) == 0) and (len(sig_parts) > 0)
    if first:
        state_set("first_hold_step", step)
    ledger_append({"cart_change_step": step, "changed_sig": new_sig != prev_sig, "sig": new_sig})
    if first:
        fire_trigger("first_add")
    return {"id": pid, "number": after}

def tool_close_task(args):
    if args.get("methodType") == "no_order":
        request_decline()
        return {"went_through": True}
    lines = basket_get()
    if len(lines) == 0:
        return {"fault": TROUBLE_EMPTY}  # field: a buy on an empty order list -> NOTHING (13 of 13); no event fires on it
    request_order(lines)
    return {"went_through": True}

def tool_message_user(args):
    state_set("messages_used", state_get("messages_used", 0) + 1)
    return {"value": send_message(args.get("textText", ""))}

def call(handler, args):
    return pending_wrap({
        "hunt_listings": tool_hunt_listings,
        "show_item": tool_show_item,
        "add_selection": tool_add_selection,
        "bag_list": tool_bag_list,
        "close_task": tool_close_task,
        "message_user": tool_message_user,
    }[handler](args))

# ---------------------------------------------------------------- shopper
def setup_shopper(behaviour):
    state_set("behaviour", behaviour)
    state_set("revealed", [])
    subjects = len(behaviour["duno"])
    order = list(range(subjects))
    for i in range(subjects - 1):
        j = i + rand_below(subjects - i)
        tmp = order[i]
        order[i] = order[j]
        order[j] = tmp
    marker = "".join(["PSL39FKNYXC7ZMB8JU6RTGQEW42D5H"[rand_below(30)] for k in range(12)])
    answers = dict(behaviour["vovafo"])
    for i in range(subjects):
        answers[behaviour["melugo"][i]] = behaviour["ligubo"][order[i]]
    prompt = behaviour["meba"] + "\n".join([(behaviour["melugo"][i] + ": ") + behaviour["duno"][order[i]] for i in range(subjects)]) + behaviour["fase"] + marker + "\n"
    state_set("shopper", {"answers": answers, "prompt": prompt, "marker": marker})

def det_idx(text_low, mod):
    if mod <= 0:
        return 0
    h = 0
    for i in range(len(text_low)):
        c = text_low[i]
        h = (h * 31 + len(c) + i) % 1000003
    for w in text_low.split(" "):
        h = (h * 17 + len(w)) % 1000003
    return h % mod

def has_line_word(text_low, words):
    if not words:
        return True
    for w in words:
        if w in text_low:
            return True
    return False

def has_any_line_word(text_low, lwords):
    if not lwords:
        return True
    for key in lwords:
        if has_line_word(text_low, lwords[key]):
            return True
    return False

def is_approval_or_note(text_low):
    if ("nothing is in the cart" in text_low) or ("could not find a " in text_low) or ("noted:" in text_low) or ("sorry for the confusion" in text_low) or ("i was asking" in text_low) or ("i am asking" in text_low) or ("i will ask one question" in text_low) or ("will not wait for your answer" in text_low):
        return False
    cues = [
        "final basket", "basket before", "your basket", "the basket", "in the basket", "current basket",
        "the cart", "your cart", "in the cart", "selection holds", "basket holds", "cart holds",
        "here is the basket", "here's the basket", "placing the order", "place the order", "buying it now", "buying now",
        "shall i order", "shall i place", "shall i buy",
        "before i place", "before i order", "before i buy", "before i finish", "before ordering", "ready to order", "total before ordering",
        "order total", "cart total", "your total is", "total:", "total is ", "total comes to ",
        "may i place", "is it all right to order", "reply yes", "confirm", "approve",
    ]
    for c in cues:
        if c in text_low:
            return True
    if "?" not in text_low:
        return True
    return False

def off_pool(behaviour):
    # race 20: one off-need pool per task (per task the field's non-reveal replies are no-preference or did-not-understand, never a mix:
    # 6,815 + 10,109 replies, 0 off their task's pool)
    return behaviour["sase"][0] if bool(behaviour.get("dnu_default", False)) else behaviour["sase"][1]

def non_slot_reply(behaviour, text_low):
    pool = off_pool(behaviour)
    return pool[det_idx(text_low, len(pool))]

def ack_reply(behaviour, text_low, step, dnu_default):
    ledger_append({"ack_step": step, "last_cart_step": state_get("last_cart_step", 0)})
    if state_get("first_answer_step", 0) == 0:
        state_set("first_answer_step", step)
    pool = off_pool(behaviour)
    return pool[det_idx(text_low, len(pool))]

def message(text):
    behaviour = state_get("behaviour")
    shopper = state_get("shopper")
    step = counters()["step"]
    text_low = text.lower()
    dnu_default = bool(behaviour.get("dnu_default", False))

    # a note with no question mark is answered from the task's off-need pool without the labeler; one WITH a question mark is put to the labeler first
    approval = is_approval_or_note(text_low)
    if approval and ("?" not in text_low):
        return ack_reply(behaviour, text_low, step, dnu_default)

    cleaned = text
    for k in range(len(text)):
        if shopper["marker"] not in cleaned:
            break
        cleaned = "".join(cleaned.split(shopper["marker"]))
    lwords = behaviour.get("line_words", {})
    is_multi_line = "line1" in lwords
    label = -2
    for s in behaviour["kubono"]:
        if "meza" in s:
            decided = decide_label(behaviour, s, text)
            if decided != None:
                label = decided[0]
                break
        else:
            if is_multi_line and (not has_any_line_word(text_low, lwords)):
                label = -2
                break
            reply = model_call(s["rahi"], (((shopper["prompt"] + cleaned) + "\n") + shopper["marker"]) + behaviour["sufe"], s["gutubi"])
            label = shopper["answers"].get(reply["text"].strip(), -2) if reply["ok"] else -2
            if label != -2:
                break
    if approval and (label < 0):
        return ack_reply(behaviour, text_low, step, dnu_default)

    state_set("questions_used", state_get("questions_used", 0) + 1)
    ledger_append({"question_step": step})
    if state_get("first_answer_step", 0) == 0:
        state_set("first_answer_step", step)
    if label >= 0:
        first_reveal = len(state_get("revealed")) == 0
        if label not in state_get("revealed"):
            state_set("revealed", state_get("revealed") + [label])
            ledger_append({"revealed_need": label})
            if first_reveal:
                fire_trigger("after_reveal")
        pool = behaviour["sase"][label + 2]
        return pool[det_idx(text_low, len(pool))]
    return non_slot_reply(behaviour, text_low)

def decide_label(behaviour, step, text):
    reply = model_decide(step["rahi"], {"message": text}, behaviour["botisi"], step["gutubi"])
    if not reply["ok"]:
        return None
    answers = reply["answers"]
    if (type(answers) == "dict") and ("answers" in answers):
        answers = answers["answers"]
    if type(answers) != "dict":
        return None
    scores = {}
    for key in behaviour["botisi"]:
        item = answers.get(key)
        if (type(item) != "dict") or (type(item.get("noul")) not in ["float", "int"]):
            return None
        value = item["noul"]
        if ((value < 0) or (value > 1)) or ((value > step["devizu"]) and (value < step["meza"])):
            return None
        scores[key] = value
    if scores[behaviour["jekaro"]] >= step["meza"]:
        return [-1]
    raw_hits = [key for key in behaviour["viroju"] if (scores[key] >= step["meza"])]
    if raw_hits == []:
        return [-2]
    return [credit_decide(behaviour, text, raw_hits)]  # race 20: the fitted told share of the message's cell, one draw per message (runs/r20_forge/credit_model_r20.json)

# ---------------------------------------------------------------- question credit (race-20 fit: runs/r20_forge/credit_model_r20.json)
# Race 20's shopper answers lists: a need named FIRST with its own item is told (99%), a need named later is told by its place among the
# names of the message, by the task's off-need voice (no view / did not follow), by whether it stands in the first question of the message
# and by the item it is asked with.  One draw per message from the episode PRNG seed and the message index; the table is fitted on every
# released race-20 question (credit_fit_r20.py).  The block is valid Python as well: the fit and `sn15 s-expected-told` execute it as it stands.
