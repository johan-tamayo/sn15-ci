# Race-17 Starlark World (`s14_r17`, 45 Open Tasks, `w-forge-s14-r17`)
# Reproduces the Race-17 mechanics seen in the released open episodes:
#   * 8 tools: ItemRead (full card), BuyerAsk, PassNow, ItemsLocate (search), ListMyItems, RemainingNow, SetToCart (place adds / remove subtracts one line), OrderNow
#   * ItemsLocate: the marks ( ) , - . : ; | of Lookup read as spaces, the first 6 words, AND over the analyzed terms, matches in ascending listing id,
#     top 500, 12 rows from the row offset Lead (0..60), page_next_page = Lead + 12 while more rows remain and Lead + 12 <= 60
#   * cards are dicts; facts and remarks_section only on ItemRead (split view)
#   * 2-message allowance (BuyerAsk cost 1, budget 2); RemainingNow shows the message meter
#   * events: triggers first_add (first SetToCart that leaves a line) | after_reveal (first need revealed) | finish (first OrderNow / PassNow); kinds budget | drop | stock;
#     everything not yet fired fires at the first close; the notice echoes on the next call as {pehidu, tuzaju}
#   * persona: 12 reveal frames, one off-need pool per task (nopref, or did-not-understand on dnu_default tasks)
#   * BuyerAsk credit: race 17's own position / shelf-context table, one PRNG draw per message (fit: runs/r17_forge/credit_model_r17.json)
#   * graded: every need revealed, every chain page and every ordered listing opened via ItemRead, one answer slot per fired-event bitmask

TEXT_INDEX = "jasu"
CATEGORY_INDEX = "nemogi"
BRAND_INDEX = "kojefe"
PAGE_ROWS = 12
MAX_LEAD = 60
TEXT_HITS_CAP = 500  # the field's `hit_found` saturates at 500
LINE_MAX = 4  # field: a line over 4 is refused (E50), the schema's NumberNeeded maximum
ALL_TERMS = True
TOKEN_FOLLOWS_LIVE = False
TROUBLE_REF = "E49"
TROUBLE_EMPTY = "E49"
TROUBLE_LINE = "E50"
TOOLS = ["ItemRead", "BuyerAsk", "PassNow", "ItemsLocate", "ListMyItems", "RemainingNow", "SetToCart", "OrderNow"]

def start(envelope):
    params = envelope["params"]
    for name in TOOLS:
        set_cost(name, "steps", 1)
    set_budget("steps", params.get("step_budget", 43))
    msg_cap = params.get("message_budget", 2)
    set_cost("BuyerAsk", "messages", 1)
    set_budget("messages", msg_cap)
    state_set("message_budget", msg_cap)
    state_set("events", params.get("events", []))
    state_set("fired_idx", [])
    state_set("fired_step", [])
    state_set("pending", [])
    state_set("voiced", [])
    state_set("ov_price", {})
    state_set("gone", [])
    state_set("messages_used", 0)
    state_set("questions_used", 0)
    state_set("last_cart_step", 0)
    state_set("last_cart_sig", "")
    state_set("first_hold_step", 0)
    state_set("first_answer_step", 0)
    setup_shopper(params["bezifa"])
    state_set("credit_seed", rand_below(1000000007))  # FORGE4: the question-credit draws of this episode
    return None

def row_of(item_id):
    return catalog_get(item_id)

def eff_price(row):
    ov = state_get("ov_price", {})
    if row["id"] in ov:
        return ov[row["id"]]
    return row.get("price", 0)

def eff_stock(row):
    if row["id"] in state_get("gone", []):
        return False
    return row.get("in_stock")

def turn():
    return None

# ---------------------------------------------------------------- store events
def needs_target(event):
    return event["kind"] in ["stock", "price"]

def fire_one(i, item, step):
    # event i happens (to the held listing `item` when it needs one; None there: the event is void - consumed with no effect); its echo is queued for the next call
    events = state_get("events", [])
    event = events[i]
    ov = state_get("ov_price", {})
    gone = state_get("gone", [])
    price_to = None
    if item != None:
        row = row_of(item)
        if event["kind"] == "price":
            base = ov.get(item, row.get("price", 0))
            price_to = (base * event["pct"]) // 100
            ov[item] = price_to
        elif event["kind"] == "stock":
            if item not in gone:
                gone.append(item)
    state_set("ov_price", ov)
    state_set("gone", gone)
    fired = state_get("fired_idx", [])
    fired.append(i)
    state_set("fired_idx", fired)
    fs = state_get("fired_step", [])
    fs.append([i, step])
    state_set("fired_step", fs)
    ledger_append({"situ": i, "item": item if needs_target(event) else None, "kind": event["kind"], "step": step, "price_to": price_to, "silent": not event.get("echo", False)})
    if event.get("echo", False):
        pend = state_get("pending", [])
        pend.append([step, i])
        state_set("pending", pend)

def fire_trigger(trigger):
    # first_add: at the first SetToCart that leaves a line in the basket; after_reveal: at the first need revealed
    events = state_get("events", [])
    lines = basket_get()
    step = counters()["step"]
    for i in range(len(events)):
        if (i in state_get("fired_idx", [])) or (events[i].get("trigger", "finish") != trigger):
            continue
        item = None
        if len(lines) > 0:
            item = lines[0]["id"]
        if needs_target(events[i]) and (item == None):
            continue
        fire_one(i, item, step)

def step_fired(i):
    for p in state_get("fired_step", []):
        if p[0] == i:
            return p[1]
    return -1

def can_finish(order):
    events = state_get("events", [])
    if len(events) == 0:
        return {"observation": None, "ok": True}
    is_skip = (type(order) == "dict") and (order.get("kind") == "decline")
    step = counters()["step"]
    lines = basket_get()
    sentences = []
    for i in range(len(events)):
        event = events[i]
        if i in state_get("fired_idx", []):
            # field: an event that fired on the call right before the close (a SetToCart, a reveal) is listed in the refusal - the silent first-hold
            # sell-out of t-9da2989139 is voiced only this way (5 of 5 orders right after the first hold), the first-hold budget notices of
            # t-a537f52bbd / t-d332b62aa4 likewise (6 + 6); an event a refused close already listed is not listed again (1,158 of 1,158 closes
            # right after a refused close go through)
            if (step_fired(i) == step - 1) and (i not in state_get("voiced", [])):
                sentences.append(event["sent"])
                state_set("voiced", state_get("voiced", []) + [i])
            continue
        # everything not yet fired fires at the first close
        if needs_target(event) and (is_skip or (len(lines) == 0)):
            # no held line to hit (PassNow, or an empty basket): void - not in the refusal, never retried
            fire_one(i, None, step)
            state_set("voiced", state_get("voiced", []) + [i])
            continue
        item = None
        if len(lines) > 0:
            item = lines[0]["id"]
        fire_one(i, item, step)
        sentences.append(event["sent"])
        state_set("voiced", state_get("voiced", []) + [i])
    if len(sentences) > 0:
        return {"observation": sentences, "ok": False}
    return {"observation": None, "ok": True}

def pending_wrap(result):
    pend = state_get("pending", [])
    step = counters()["step"]
    ready = [p for p in pend if p[0] < step]
    if ready:
        state_set("pending", [p for p in pend if p[0] >= step])
        events = state_get("events", [])
        # field: a wrapped BuyerAsk carries the bare reply string in `tuzaju` (833 str), not {"value": ...}
        inner = result["value"] if ((type(result) == "dict") and (len(result) == 1) and ("value" in result)) else result
        return {"pehidu": [events[p[1]]["sent"] for p in ready], "tuzaju": inner}
    return result

# ---------------------------------------------------------------- tools
def desc_of(row):
    text = row.get("description")
    if type(text) != "string":
        return ""
    return text

def row_obj(row, full):
    out = {
        "can_buy": eff_stock(row),
        "details_text": desc_of(row),
        "id": row.get("id"),
        "producer_name": row.get("maker"),
        "section_path": row.get("category"),
        "seller": row.get("merchant"),
        "title": row.get("title"),
        "unit_price": eff_price(row),
    }
    if full:
        facts = row.get("facts")
        out["facts"] = facts if type(facts) == "dict" else {}
        out["remarks_section"] = row.get("seller_notes_text")
    return out

QUERY_SPLIT = "(),-.:;|"  # the marks the live store reads as spaces in the search words (fit: runs/r17_forge/search_fit_r17.json)
QUERY_WORDS = 6  # how many words it reads (0 = every word)

def clean_query(query):
    buf = ""
    for ch in query.elems():
        buf += " " if ch in QUERY_SPLIT else ch
    words = buf.split()
    if QUERY_WORDS > 0:
        words = words[:QUERY_WORDS]
    return " ".join(words)

def text_search_ids(query):
    query = clean_query(query)
    if query == "":
        return []
    found = search(TEXT_INDEX, query, {"all_terms": ALL_TERMS, "k": 1000})
    if found["ok"] == False:
        return []
    out = []
    for hit in found["hits"]:
        if row_of(hit["id"]) != None:
            out.append(hit["id"])
    # the live store lists the matches in ascending listing id (the index scores every match the same: bm25 k1 0)
    return sorted(out)[:TEXT_HITS_CAP]

def count_key(query):
    return clean_query(query).lower()

def tool_items_locate(args):
    words = str(args.get("Lookup", "")).strip()
    lead = args.get("Lead")
    if lead == None:
        lead = 0
    ids = text_search_ids(words) if words != "" else []
    count = len(ids)
    live = LOCATE_LIVE_COUNT.get(count_key(words))
    if (live != None) and (live > count):
        count = live  # the live store holds listings no field page showed: the recorded `hit_found` of this search
    if count > TEXT_HITS_CAP:
        count = TEXT_HITS_CAP
    rows = ids[lead:lead + PAGE_ROWS]
    # live: a next page while Lead + 12 < hit_found and Lead + 12 <= 60. The pack holds only listings some field page showed, so where the live count
    # runs past its own rows the token follows the live count only when TOKEN_FOLLOWS_LIVE (off: a token never leads to a page the pack cannot fill)
    reach = count if TOKEN_FOLLOWS_LIVE else len(ids)
    onward = (lead + PAGE_ROWS) if ((lead + PAGE_ROWS < reach) and (lead + PAGE_ROWS <= MAX_LEAD)) else None
    return {"hit_found": count, "page_next_page": onward, "search_listings": [row_obj(row_of(i), False) for i in rows]}

def tool_item_read(args):
    row = row_of(args.get("ItemId", ""))
    if row == None:
        return {"trouble_message": TROUBLE_REF}
    return row_obj(row, True)

def line_qty(pid):
    for ln in basket_get():
        if ln["id"] == pid:
            return ln["quantity"]
    return 0

def bag_summary():
    lines_out = []
    total = 0
    for line in basket_get():
        row = row_of(line["id"])
        price = eff_price(row)
        total += price * line["quantity"]
        lines_out.append({"id": line["id"], "line_qty": line["quantity"], "title": row.get("title"), "unit_price": price})
    return {"current_bag": lines_out, "owed": total}

def tool_list_my_items(args):
    return bag_summary()

def tool_set_to_cart(args):
    pid = args.get("ItemIdCode", "")
    if row_of(pid) == None:
        return {"trouble_message": TROUBLE_REF}  # field: an id the store does not hold -> E49 (place and remove alike), the basket is unchanged
    kind = args.get("StepKind")
    amount = args.get("NumberNeeded")
    if amount == None:
        amount = 1  # field: no NumberNeeded = one (260 places 0 -> 1; 133 removes one down)
    before = line_qty(pid)
    if kind == "remove":
        after = before - amount
        if after < 0:
            after = 0  # field: remove never goes below 0 (3 held, remove 4 -> 0); a listing not held answers line_qty 0
    else:
        after = before + amount  # field: place ADDS to the line (1 held, place 2 -> 3: 124 of 124)
        if after > LINE_MAX:
            return {"trouble_message": TROUBLE_LINE}  # field: a line over 4 -> E50 (46 of 46), the basket is unchanged
    if after != before:
        basket_set(pid, after)
    sig_parts = []
    for ln in basket_get():
        sig_parts.append(ln["id"] + ":" + str(ln["quantity"]))
    new_sig = ",".join(sorted(sig_parts))
    step = counters()["step"]
    prev_sig = state_get("last_cart_sig", "")
    if new_sig != prev_sig:
        state_set("last_cart_step", step)
        state_set("last_cart_sig", new_sig)
    first = (state_get("first_hold_step", 0) == 0) and (len(sig_parts) > 0)
    if first:
        state_set("first_hold_step", step)
    ledger_append({"cart_change_step": step, "changed_sig": new_sig != prev_sig, "sig": new_sig})
    if first:
        fire_trigger("first_add")
    return {"id": pid, "line_qty": after}

def tool_order_now(args):
    lines = basket_get()
    if len(lines) == 0:
        return {"trouble_message": TROUBLE_EMPTY}  # field: an order on an empty basket -> E49 (30 of 30); no event fires on it
    request_order(lines)
    return {"was_fine": True}

def tool_pass_now(args):
    request_decline()
    return {"was_fine": True}

def tool_buyer_ask(args):
    state_set("messages_used", state_get("messages_used", 0) + 1)
    return {"value": send_message(args.get("TextText", ""))}

def tool_remaining_now(args):
    used = state_get("messages_used", 0)
    left = state_get("message_budget", 2) - used
    if left < 0:
        left = 0
    return {"reto": {"taken_count": used, "unspent_count": left}}

def call(handler, args):
    return pending_wrap({
        "items_locate": tool_items_locate,
        "item_read": tool_item_read,
        "set_to_cart": tool_set_to_cart,
        "list_my_items": tool_list_my_items,
        "order_now": tool_order_now,
        "pass_now": tool_pass_now,
        "buyer_ask": tool_buyer_ask,
        "remaining_now": tool_remaining_now,
    }[handler](args))

# ---------------------------------------------------------------- shopper
def setup_shopper(behaviour):
    state_set("behaviour", behaviour)
    state_set("revealed", [])
    subjects = len(behaviour["duno"])
    order = list(range(subjects))
    for i in range(subjects - 1):
        j = i + rand_below(subjects - i)
        tmp = order[i]
        order[i] = order[j]
        order[j] = tmp
    marker = "".join(["PSL39FKNYXC7ZMB8JU6RTGQEW42D5H"[rand_below(30)] for k in range(12)])
    answers = dict(behaviour["vovafo"])
    for i in range(subjects):
        answers[behaviour["melugo"][i]] = behaviour["ligubo"][order[i]]
    prompt = behaviour["meba"] + "\n".join([(behaviour["melugo"][i] + ": ") + behaviour["duno"][order[i]] for i in range(subjects)]) + behaviour["fase"] + marker + "\n"
    state_set("shopper", {"answers": answers, "prompt": prompt, "marker": marker})

def det_idx(text_low, mod):
    if mod <= 0:
        return 0
    h = 0
    for i in range(len(text_low)):
        c = text_low[i]
        h = (h * 31 + len(c) + i) % 1000003
    for w in text_low.split(" "):
        h = (h * 17 + len(w)) % 1000003
    return h % mod

def has_line_word(text_low, words):
    if not words:
        return True
    for w in words:
        if w in text_low:
            return True
    return False

def has_any_line_word(text_low, lwords):
    if not lwords:
        return True
    for key in lwords:
        if has_line_word(text_low, lwords[key]):
            return True
    return False

def is_approval_or_note(text_low):
    if ("nothing is in the cart" in text_low) or ("could not find a " in text_low) or ("noted:" in text_low) or ("sorry for the confusion" in text_low) or ("i was asking" in text_low) or ("i am asking" in text_low) or ("i will ask one question" in text_low) or ("will not wait for your answer" in text_low):
        return False
    cues = [
        "final basket", "basket before", "your basket", "the basket", "in the basket", "current basket",
        "the cart", "your cart", "in the cart", "selection holds", "basket holds", "cart holds",
        "here is the basket", "here's the basket", "placing the order", "place the order", "buying it now", "buying now",
        "shall i order", "shall i place", "shall i buy",
        "before i place", "before i order", "before i buy", "before i finish", "before ordering", "ready to order", "total before ordering",
        "order total", "cart total", "your total is", "total:", "total is ", "total comes to ",
        "may i place", "is it all right to order", "reply yes", "confirm", "approve",
    ]
    for c in cues:
        if c in text_low:
            return True
    if "?" not in text_low:
        return True
    return False

def non_slot_reply(behaviour, text_low):
    # race 17: one off-need pool per task (per task the field's non-reveal replies are no-preference or did-not-understand, never a mix)
    dnu_default = bool(behaviour.get("dnu_default", False))
    pool = behaviour["sase"][0] if dnu_default else behaviour["sase"][1]
    return pool[det_idx(text_low, len(pool))]

def ack_reply(behaviour, text_low, step, dnu_default):
    ledger_append({"ack_step": step, "last_cart_step": state_get("last_cart_step", 0)})
    if state_get("first_answer_step", 0) == 0:
        state_set("first_answer_step", step)
    pool = behaviour["sase"][0] if dnu_default else behaviour["sase"][1]
    return pool[det_idx(text_low, len(pool))]

def message(text):
    behaviour = state_get("behaviour")
    shopper = state_get("shopper")
    step = counters()["step"]
    text_low = text.lower()
    dnu_default = bool(behaviour.get("dnu_default", False))

    # a note with no question mark is answered from the task's off-need pool without the labeler; one WITH a question mark is put to the labeler first
    approval = is_approval_or_note(text_low)
    if approval and ("?" not in text_low):
        return ack_reply(behaviour, text_low, step, dnu_default)

    cleaned = text
    for k in range(len(text)):
        if shopper["marker"] not in cleaned:
            break
        cleaned = "".join(cleaned.split(shopper["marker"]))
    lwords = behaviour.get("line_words", {})
    is_multi_line = "line1" in lwords
    label = -2
    for s in behaviour["kubono"]:
        if "meza" in s:
            decided = decide_label(behaviour, s, text)
            if decided != None:
                label = decided[0]
                break
        else:
            if is_multi_line and (not has_any_line_word(text_low, lwords)):
                label = -2
                break
            reply = model_call(s["rahi"], (((shopper["prompt"] + cleaned) + "\n") + shopper["marker"]) + behaviour["sufe"], s["gutubi"])
            label = shopper["answers"].get(reply["text"].strip(), -2) if reply["ok"] else -2
            if label != -2:
                break
    if approval and (label < 0):
        return ack_reply(behaviour, text_low, step, dnu_default)

    state_set("questions_used", state_get("questions_used", 0) + 1)
    ledger_append({"question_step": step})
    if state_get("first_answer_step", 0) == 0:
        state_set("first_answer_step", step)
    if label == -3:
        pool = behaviour["tugo"]
        return pool[det_idx(text_low, len(pool))]
    if label >= 0:
        first_reveal = len(state_get("revealed")) == 0
        if label not in state_get("revealed"):
            state_set("revealed", state_get("revealed") + [label])
            ledger_append({"revealed_need": label})
            if first_reveal:
                fire_trigger("after_reveal")
        pool = behaviour["sase"][label + 2]
        return pool[det_idx(text_low, len(pool))]
    return non_slot_reply(behaviour, text_low)

def decide_label(behaviour, step, text):
    reply = model_decide(step["rahi"], {"message": text}, behaviour["botisi"], step["gutubi"])
    if not reply["ok"]:
        return None
    answers = reply["answers"]
    if (type(answers) == "dict") and ("answers" in answers):
        answers = answers["answers"]
    if type(answers) != "dict":
        return None
    scores = {}
    for key in behaviour["botisi"]:
        item = answers.get(key)
        if (type(item) != "dict") or (type(item.get("noul")) not in ["float", "int"]):
            return None
        value = item["noul"]
        if ((value < 0) or (value > 1)) or ((value > step["devizu"]) and (value < step["meza"])):
            return None
        scores[key] = value
    if scores[behaviour["jekaro"]] >= step["meza"]:
        return [-1]
    text_low = text.lower()
    lwords = behaviour.get("line_words", {})
    raw_hits = [key for key in behaviour["viroju"] if (scores[key] >= step["meza"])]
    if raw_hits == []:
        return [-2]
    return [credit_decide(behaviour, text, raw_hits)]  # FORGE4: the live credit of the hits by position / shelf context, one draw per message (runs/forge4/HANDOVER.md)

# ---------------------------------------------------------------- question credit (FORGE4: runs/forge4/HANDOVER.md)
# The live labeler credits a question that names a hidden need by WHERE the need sits among the question's names: the first name is
# always read, a later one about half the time, the last name of a long list rarely; on a multi-line task a name without the need's
# shelf word (singular or plural) is read less often and one with another line's shelf word almost never; a decoy named before the need blocks the reading
# ~40%; a second need after a read need is never credited.  One draw per message from the episode PRNG seed and the message index.
CREDIT_P_ORD_TIER = {"1L": {"k1": {"first": 0.999, "unplaced": 0.533}, "k2": {"first": 0.978, "last": 0.42, "unplaced": 0.476}, "k3": {"first": 0.978, "last": 0.42, "second": 0.524, "unplaced": 0.476}, "k4-5": {"first": 1.0, "last": 0.455, "middle": 0.468, "second": 0.468, "unplaced": 0.5}, "k6+": {"first": 1.0, "last": 0.455, "middle": 0.468, "second": 0.468, "unplaced": 0.5}}, "ML": {"k1": {"first": 1.0, "unplaced": 0.833}, "k2": {"first": 0.985, "last": 0.682, "unplaced": 1.0}, "k3": {"first": 0.985, "last": 0.682, "second": 0.727, "unplaced": 1.0}, "k4-5": {"first": 0.972, "last": 0.706, "middle": 0.678, "second": 0.678, "unplaced": 0.972}, "k6+": {"first": 0.972, "last": 0.706, "middle": 0.678, "second": 0.678, "unplaced": 0.972}}}
CREDIT_F_CTX = {"1L": 1.0, "neither": 0.754, "other": 0.03, "own": 1.0, "own+other k1": 0.768, "own+other list": 0.572}
CREDIT_DECOY_CONSUME = 0.59
CREDIT_INTERROGATIVES = ["what ", "which "]
CREDIT_WANT_FOR = ["want for ", "like for ", "need for ", "want on ", "want in ", "need in ", "care about ", "looking for ", "want from ", "need from ", "want ", "need "]
CREDIT_PREFERENCE = ["preference for the ", "preference for ", "preferences for ", "preference on ", "prefer "]
CREDIT_CUTS = [" would you", " do you", " should ", " for the ", " for your ", " for my ", " for a ", " for an ", " for this ", " of the ", " on the ", " in the ", " for example", " such as", " e.g.", " like ", " please", " so i ", " so that ", " - "]
CREDIT_SEPS = [",", ";", " or ", " and ", " / "]
# joiners that also list names ("material & colour", "size/fit"); searched on a copy with the task's item words blanked
CREDIT_JOINERS = ["&", "+", "/", "\n", " plus ", " as well as ", " along with ", " together with ", " nor ", " versus ", " vs "]

def credit_draw(idx):
    x = (state_get("credit_seed", 0) * 2654435761 + idx * 40503 + 12345) % 4294967296
    x = ((x ^ (x >> 16)) * 2246822519) % 4294967296
    x = ((x ^ (x >> 13)) * 3266489917) % 4294967296
    x = x ^ (x >> 16)
    return x % 10000

def credit_span_end(ql, start):
    end = ql.find("?", start)
    if end < 0:
        end = len(ql)
    lo = start - 1
    if lo < 0:
        lo = 0
    for cut in CREDIT_CUTS:
        j = ql.find(cut, lo, end)
        if (j >= 0) and (j < end):
            end = j
            if end < start:
                end = start
    return end

def credit_last_marker(ql, markers, lo, hi):
    best = -1
    for m in markers:
        i = ql.rfind(m, lo, hi)
        if (i >= 0) and (i + len(m) > best):
            best = i + len(m)
    return best

def credit_split_span(ql, start, end, masked = None):
    parts = []
    pos = start
    for n in range(64):
        best = -1
        blen = 0
        for sep in CREDIT_SEPS:
            j = ql.find(sep, pos, end)
            if (j >= 0) and ((best < 0) or (j < best)):
                best = j
                blen = len(sep)
        if masked != None:
            for sep in CREDIT_JOINERS:
                j = masked.find(sep, pos, end)
                if (j >= 0) and ((best < 0) or (j < best)):
                    best = j
                    blen = len(sep)
        if best < 0:
            break
        parts.append([pos, best])
        pos = best + blen
    parts.append([pos, end])
    return [p for p in parts if ql[p[0]:p[1]].strip() != ""]

def credit_name_span(ql, masked = None):
    # after the last interrogative before the first '?' (a colon after it wins when its list has more separators); if that span is
    # empty ("what do you want for ..."), after the last "want for"-type phrase after the interrogative; without an interrogative,
    # after a "preference for"-type phrase, else a colon, else the text start
    q_end = ql.find("?")
    if q_end < 0:
        q_end = len(ql)
    si = credit_last_marker(ql, CREDIT_INTERROGATIVES, 0, q_end)
    if si >= 0:
        ei = credit_span_end(ql, si)
        if ql[si:ei].strip() != "":
            c = ql.rfind(":", si, q_end)
            if c >= 0:
                ec = credit_span_end(ql, c + 1)
                if len(credit_split_span(ql, c + 1, ec, masked)) > len(credit_split_span(ql, si, ei, masked)):
                    return [c + 1, ec]
            return [si, ei]
        sw = credit_last_marker(ql, CREDIT_WANT_FOR, si, q_end)
        if sw >= 0:
            return [sw, credit_span_end(ql, sw)]
        c = ql.rfind(":", si, q_end)
        if c >= 0:
            return [c + 1, credit_span_end(ql, c + 1)]
        return [si, ei]
    sp = credit_last_marker(ql, CREDIT_PREFERENCE, 0, q_end)
    if sp >= 0:
        return [sp, credit_span_end(ql, sp)]
    c = ql.rfind(":", 0, q_end)
    if c >= 0:
        return [c + 1, credit_span_end(ql, c + 1)]
    return [0, credit_span_end(ql, 0)]

def credit_mask_items(ql, behaviour):
    masked = ql
    lwords = behaviour.get("line_words", {})
    for key in lwords:
        for w in lwords[key]:
            wl = str(w).lower()
            blank = wl
            for sep in CREDIT_JOINERS:
                blank = blank.replace(sep, " " * len(sep))
            if (wl == "") or (blank == wl):
                continue
            pos = 0
            for n in range(64):
                i = ql.find(wl, pos)
                if i < 0:
                    break
                masked = masked[:i] + blank + masked[i + len(wl):]
                pos = i + len(wl)
    return masked

def credit_name_parts(ql, behaviour = None):
    masked = None if behaviour == None else credit_mask_items(ql, behaviour)
    span = credit_name_span(ql, masked)
    return credit_split_span(ql, span[0], span[1], masked)

def credit_tokens(ql):
    out = []
    cur = ""
    start = -1
    for i in range(len(ql)):
        ch = ql[i]
        if ch.isalnum():
            if start < 0:
                start = i
            cur += ch
        else:
            if start >= 0:
                out.append([start, cur])
            cur = ""
            start = -1
    if start >= 0:
        out.append([start, cur])
    return out

def credit_stems(prop):
    words = []
    cur = ""
    for ch in prop.lower().elems():
        if ch.isalnum():
            cur += ch
        else:
            if cur != "":
                words.append(cur)
            cur = ""
    if cur != "":
        words.append(cur)
    return [(w[:-1] if (len(w) > 1 and w.endswith("s")) else w) for w in words]

def credit_phrase_span(toks, prop):
    st = credit_stems(prop)
    if len(st) == 0:
        return None
    for i in range(len(toks) - len(st) + 1):
        ok = True
        for j in range(len(st)):
            t = toks[i + j][1]
            if (t != st[j]) and (t != st[j] + "s"):
                ok = False
                break
        if ok:
            return [i, len(st)]
    return None

def credit_phrase_pos(toks, prop):
    sp = credit_phrase_span(toks, prop)
    if sp == None:
        return -1
    return toks[sp[0]][0]

def credit_shelf_matches(toks, lwords, own_words):
    # [own, other]: a line's shelf word present as a phrase (each token with an optional plural s); a match inside a LONGER
    # match of another line does not count ("phone case" inside "samsung galaxy phone case")
    found = []
    for lk in lwords:
        if not lk.startswith("line"):
            continue
        is_own = lwords[lk] == own_words
        for w in lwords[lk]:
            sp = credit_phrase_span(toks, w)
            if sp != None:
                found.append([sp[0], sp[1], is_own])
    own = False
    other = False
    for f in found:
        dominated = False
        for g in found:
            if (g[2] != f[2]) and (g[1] > f[1]) and (g[0] <= f[0]) and (f[0] + f[1] <= g[0] + g[1]):
                dominated = True
        if not dominated:
            if f[2]:
                own = True
            else:
                other = True
    return [own, other]

def credit_kcls(k):
    if k <= 1:
        return "k1"
    if k == 2:
        return "k2"
    if k == 3:
        return "k3"
    if k <= 5:
        return "k4-5"
    return "k6+"

def credit_ocls(o, k):
    if o < 0:
        return "unplaced"
    if o == 0:
        return "first"
    if o >= k - 1:
        return "last"
    if o == 1:
        return "second"
    return "middle"

def credit_prop(behaviour, key):
    parts = str(behaviour["botisi"][key]["instructions"]).split("'")
    if len(parts) >= 3:
        return parts[-2]
    return ""

def credit_ctx(toks, behaviour, key, k):
    lwords = behaviour.get("line_words", {})
    if "line1" not in lwords:
        return "1L"
    m = credit_shelf_matches(toks, lwords, lwords.get(key, []))
    own = m[0]
    other = m[1]
    if own and other:
        if k == 1:
            return "own+other k1"
        return "own+other list"
    if own:
        return "own"
    if other:
        return "other"
    return "neither"

def credit_decide(behaviour, text, hit_keys):
    ql = text.lower()
    parts = credit_name_parts(ql, behaviour)
    k = len(parts)
    if k < 1:
        k = 1
    toks = credit_tokens(ql)
    hits = []
    for key in hit_keys:
        label = behaviour["viroju"][key]
        pos = credit_phrase_pos(toks, credit_prop(behaviour, key))
        ordinal = -1
        if pos >= 0:
            for i in range(len(parts)):
                if (parts[i][0] <= pos) and (pos < parts[i][1]):
                    ordinal = i
        ctx = credit_ctx(toks, behaviour, key, k)
        if ordinal < 0:
            rank = 1000000000 + (pos if pos >= 0 else 0)
        else:
            rank = ordinal * 100000 + pos
        hits.append([rank, key, label, ordinal, ctx])
    hits = sorted(hits)
    u = credit_draw(state_get("messages_used", 0)) / 10000.0
    acc = 0.0
    reach = 1.0
    kc = credit_kcls(k)
    tier = "ML" if ("line1" in behaviour.get("line_words", {})) else "1L"
    for h in hits:
        label = h[2]
        vis = CREDIT_F_CTX[h[4]]
        if label >= 0:
            p = CREDIT_P_ORD_TIER[tier][kc][credit_ocls(h[3], k)]
            p_credit = vis * p
            p_stop = vis * (1.0 - p)
        else:
            p_credit = 0.0
            p_stop = vis * CREDIT_DECOY_CONSUME
        if u < acc + reach * p_credit:
            return label
        if u < acc + reach * (p_credit + p_stop):
            return -2
        acc += reach * (p_credit + p_stop)
        reach *= (1.0 - p_credit - p_stop)
    return -2

# ---------------------------------------------------------------- grading
def price_of(prices, ov, item_id):
    if item_id in ov:
        return ov[item_id]
    if item_id in prices:
        return prices[item_id]
    row = catalog_get(item_id)
    return row.get("price", 0) if row != None else 0

def order_total(lines, prices, ov):
    total = 0
    for line in lines:
        total += price_of(prices, ov, line["id"]) * line["quantity"]
    return total

def permutations_of(n):
    perms = [[]]
    for k in range(n):
        grown = []
        for p in perms:
            for i in range(n):
                if i not in p:
                    grown.append(p + [i])
        perms = grown
    return perms

def fits_hold(lines, perm, fitok):
    # cross-line rules of the request (a bulb must fit the lamp chosen, "The Y's Q must be W, except when the X's P is V"): a violating basket is request_not_met
    inv = {}
    for i in range(len(perm)):
        inv[perm[i]] = i
    for pair in fitok:
        ia = inv.get(pair["a"])
        ib = inv.get(pair["b"])
        if (ia == None) or (ib == None):
            continue
        allowed = pair["ok"].get(lines[ia]["id"])
        if (allowed != None) and (lines[ib]["id"] not in allowed):
            return False
    return True

def lines_claim_answer_lines(lines, answer_lines, key, gone, fitok = []):
    n = len(lines)
    if n != len(answer_lines):
        return False
    # which basket line can stand for which wanted line (listing in the line's list, not sold out, the wanted quantity)
    can = []
    for i in range(n):
        row = []
        for j in range(n):
            target = answer_lines[j]
            row.append((lines[i]["id"] in target[key]) and (lines[i]["id"] not in gone) and (lines[i]["quantity"] == target["kudi"]))
        can.append(row)
    for perm in permutations_of(n):
        ok = True
        for i in range(n):
            if not can[i][perm[i]]:
                ok = False
                break
        if ok and fits_hold(lines, perm, fitok):
            return True
    return False

def cheapest_total(slot, ov, gone):
    total = 0
    for line in slot["tufa"]:
        best = None
        for pid in line["lita"]:
            if pid in gone:
                continue
            c = price_of(slot["fari"], ov, pid) * line["kudi"]
            if (best == None) or (c < best):
                best = c
        if best == None:
            return None
        total += best
    return total

def accepted(slot, lines, reason, key, ov, gone, dyn):
    if reason == "decline":
        if slot.get("nodecline", False):
            return False
        if not dyn:
            return slot["tele"]
        if slot["tele"]:
            return True
        cheapest = cheapest_total(slot, ov, gone)
        return (cheapest == None) or (cheapest > slot["suhe"])
    return lines_claim_answer_lines(lines, slot["tufa"], key, gone, slot.get("fitok", [])) and (order_total(lines, slot["fari"], ov) <= slot["suhe"])

def process_complete(episode, answer, slot, reason):
    opened = {}
    revealed = {}
    for record in episode:
        if record["kind"] == "action":
            tool = record.get("tool")
            args = record.get("args")
            if type(args) != "dict":
                continue
            if tool == "ItemRead":
                opened[args.get("ItemId", "")] = True
        elif record["kind"] == "event":
            data = record["data"]
            if (type(data) == "dict") and ("revealed_need" in data):
                revealed[data["revealed_need"]] = True
    # reference chains the request states: every page of the chain opened; a chain whose property the store dropped is waived (slot.refs_off)
    off = slot.get("refs_off", [])
    refs = answer.get("refs", [])
    for k in range(len(refs)):
        if k in off:
            continue
        for item_id in refs[k]:
            if item_id not in opened:
                return False
    if reason == "order":
        # field (9,050 labelled orders): every hidden need revealed, the chain of a need revealed by reference opened, and every ordered listing
        # opened (ItemRead) at some point - a listing carted off an ItemsLocate row alone is process-missed
        for chain in answer.get("need_refs", []):
            for item_id in chain:
                if item_id not in opened:
                    return False
        for label in range(answer.get("needs", 0)):
            if label not in revealed:
                return False
        for line in episode[-1]["order"]["lines"]:
            if line["id"] not in opened:
                return False
    return True

def grade(episode, answer):
    last = episode[-1]
    reason = last["reason"]
    if (reason != "order") and (reason != "decline"):
        return {"category": "did not finish", "score": 0}
    lines = last["order"]["lines"] if (reason == "order") else []
    ov = {}
    gone = []
    mask = 0
    for record in episode:
        if record["kind"] == "event":
            data = record["data"]
            if (type(data) == "dict") and ("situ" in data):
                mask = mask + [1, 2, 4, 8, 16, 32][data["situ"]]
                if data.get("item") != None:
                    if data.get("price_to") != None:
                        ov[data["item"]] = data["price_to"]
                    if data.get("kind") == "stock":
                        gone.append(data["item"])
    fired = mask != 0
    dova = answer["dova"]
    slot = dova[mask] if mask < len(dova) else dova[0]
    dyn = bool(answer.get("dynamic", False))
    if reason == "order":
        # field: a decline is never process-missed (0 of 1,863 released declines; 86 pass with the needs left unasked)
        if not process_complete(episode, answer, slot, reason):
            return {"category": "process requirement missed", "score": 0}
    jufuli = slot["jufuli"]
    if slot.get("cheapest", False) and ((len(gone) > 0) or (len(ov) > 0)):
        # the store sold out a listing: the lowest total is the cheapest acceptable basket LEFT, never below the slot's own figure
        left = cheapest_total(slot, ov, gone)
        if (left != None) and (left > jufuli):
            jufuli = left
    verdict = 1 if accepted(slot, lines, reason, "lita", ov, gone, dyn and fired) else 0
    if (verdict == 1) and (reason == "order") and (order_total(lines, slot["fari"], ov) > jufuli):
        verdict = 2
    if verdict == 1:
        return {"category": None, "score": 1}
    # field (31 of 31 orders that hold the sold-out listing, all on the silent sell-out task t-9da2989139): `changes missed` when the order would
    # have stood without the store's change (30 of 30: an acceptable listing at the wanted quantity); an order that was never acceptable stays
    # `request not met` (1 of 1: the first listing held was not an acceptable one) - race 18's rule
    if (reason == "order") and lines_claim_answer_lines(lines, slot["tufa"], "lita", [], slot.get("fitok", [])):
        for line in lines:
            if line["id"] in gone:
                return {"category": "changes missed", "score": 0}
    if verdict == 2:
        return {"category": "not the best option", "score": 0}
    return {"category": "request not met", "score": 0}

