# Race-22 Starlark World (`s14_r22`, 45 Open Tasks, `w-forge-s14-r22`)
# Reproduces the Race-22 mechanics seen in the released open episodes:
#   * 9 tools: summaryBalance (message meter), requestConclude (buy | refuse), rangeScreen (filter listing: itemGroup / make / costAtMost),
#     itemOpen (full card), stashToBasket (the list REPLACES the trolley), userSay, listingsLocate (keyword search), bag, listingsMatchUp
#     (batch view of 1..3 listings; 4 or more -> trouble)
#   * listingsLocate: the marks ( ) , - . : ; | of freeQ read as spaces, words under 2 characters skipped, the first 3 words, AND over their analyzed terms, the matches in ascending listing id, tally_number capped at 500;
#     rangeScreen: the itemGroup's listings (any case; or, with no itemGroup, the brand's) in ascending id, make = the brand, costAtMost =
#     the highest unit price let through; neither itemGroup nor make -> trouble. 3 rows from the row offset (0..9); onward = offset + 3
#     while more rows remain and offset + 3 <= 9
#   * cards are dicts; attributes and listing_notes only on itemOpen and listingsMatchUp
#   * 3-message allowance (userSay cost 1, budget 3); summaryBalance shows the message meter
#   * events: triggers first_add (first stashToBasket that leaves a line) | after_reveal (first need revealed) | finish (first requestConclude);
#     kinds budget | drop | stock (the first held listing sells out) | price; everything not yet fired fires at the first close; the notice
#     echoes on the next call as {jahako, gefe}
#   * persona: 12 reveal frames; a ONE-AT-A-TIME pool for a message the shopper reads as several questions; one off-need pool per task
#     (no-preference, or did-not-understand on dnu_default tasks)
#   * message credit: race 22's own told and pushed-back shares by the place of the first need a message names and the names it carries
#     (fit: runs/r22_forge/credit_model_r22.json)
#   * graded: every need revealed, every chain page and every ordered listing opened (itemOpen, or listingsMatchUp of 1..3 ids), one
#     answer slot per fired-event bitmask

TEXT_INDEX = "jasu"
CATEGORY_INDEX = "nemogi"
BRAND_INDEX = "kojefe"
PAGE_ROWS = 3
MAX_LEAD = 9  # the schema's listFirst / rowRowStart maximum; the live store hands out no `onward` past it (field: 3 rows at offset 9 with more matches and no onward)
TEXT_HITS_CAP = 500  # the field's `tally_number` of a keyword search saturates at 500
WEIGH_MAX = 3  # listingsMatchUp lays out at most 3 listings; 4 or more -> trouble (schema maxItems 6)
ALL_TERMS = True
TOKEN_FOLLOWS_LIVE = False
NO_REF = "Nothing here matches that reference."
PICK_FIRST = "Pick something first, then try again."
TOOLS = ["summaryBalance", "requestConclude", "rangeScreen", "itemOpen", "stashToBasket", "userSay", "listingsLocate", "bag", "listingsMatchUp"]

def start(envelope):
    params = envelope["params"]
    for name in TOOLS:
        set_cost(name, "steps", 1)
    set_budget("steps", params.get("step_budget", 40))
    msg_cap = params.get("message_budget", 3)
    set_cost("userSay", "messages", 1)
    set_budget("messages", msg_cap)
    state_set("message_budget", msg_cap)
    state_set("events", params.get("events", []))
    state_set("fired_idx", [])
    state_set("fired_step", [])
    state_set("pending", [])
    state_set("voiced", [])
    state_set("ov_price", {})
    state_set("gone", [])
    state_set("messages_used", 0)
    state_set("questions_used", 0)
    state_set("last_cart_step", 0)
    state_set("last_cart_sig", "")
    state_set("first_hold_step", 0)
    state_set("first_answer_step", 0)
    setup_shopper(params["bezifa"])
    state_set("credit_seed", rand_below(1000000007))  # the question-credit draws of this episode
    return None

def row_of(item_id):
    return catalog_get(item_id)

def eff_price(row):
    ov = state_get("ov_price", {})
    if row["id"] in ov:
        return ov[row["id"]]
    return row.get("price", 0)

def eff_stock(row):
    if row["id"] in state_get("gone", []):
        return False
    return row.get("in_stock")

def turn():
    return None

# ---------------------------------------------------------------- store events
def needs_target(event):
    return event["kind"] in ["stock", "price"]

def fire_one(i, item, step):
    # event i happens (to the held listing `item` when it needs one; None there: the event is void - consumed with no effect); its echo is queued for the next call
    events = state_get("events", [])
    event = events[i]
    ov = state_get("ov_price", {})
    gone = state_get("gone", [])
    price_to = None
    if item != None:
        row = row_of(item)
        if event["kind"] == "price":
            base = ov.get(item, row.get("price", 0))
            price_to = (base * event["pct"]) // 100  # the live store floors (races 18-20; the builder replays every field price move with the same rule)
            ov[item] = price_to
        elif event["kind"] == "stock":
            if item not in gone:
                gone.append(item)
    state_set("ov_price", ov)
    state_set("gone", gone)
    fired = state_get("fired_idx", [])
    fired.append(i)
    state_set("fired_idx", fired)
    fs = state_get("fired_step", [])
    fs.append([i, step])
    state_set("fired_step", fs)
    ledger_append({"situ": i, "item": item if needs_target(event) else None, "kind": event["kind"], "step": step, "price_to": price_to, "silent": not event.get("echo", False)})
    if event.get("echo", False):
        pend = state_get("pending", [])
        pend.append([step, i])
        state_set("pending", pend)

def fire_trigger(trigger):
    # first_add: at the first StashToCart that leaves a line in the order list; after_reveal: at the first need revealed
    events = state_get("events", [])
    lines = basket_get()
    step = counters()["step"]
    for i in range(len(events)):
        if (i in state_get("fired_idx", [])) or (events[i].get("trigger", "finish") != trigger):
            continue
        item = None
        if len(lines) > 0:
            item = lines[0]["id"]
        if needs_target(events[i]) and (item == None):
            continue
        fire_one(i, item, step)

def step_fired(i):
    for p in state_get("fired_step", []):
        if p[0] == i:
            return p[1]
    return -1

def can_finish(order):
    events = state_get("events", [])
    if len(events) == 0:
        return {"observation": None, "ok": True}
    is_skip = (type(order) == "dict") and (order.get("kind") == "decline")
    step = counters()["step"]
    lines = basket_get()
    sentences = []
    for i in range(len(events)):
        event = events[i]
        if i in state_get("fired_idx", []):
            # an event that fired on the call right before the close (a StashToCart, a reveal) is listed in the refusal; an event a refused
            # close already listed is not listed again
            if (step_fired(i) == step - 1) and (i not in state_get("voiced", [])) and not (needs_target(event) and is_skip):
                sentences.append(event["sent"])
                state_set("voiced", state_get("voiced", []) + [i])
            continue
        # everything not yet fired fires at the first close
        if needs_target(event) and (is_skip or (len(lines) == 0)):
            # no held line to hit (cancel, or an empty order list): void - not in the refusal, never retried, still echoed when it echoes
            fire_one(i, None, step)
            state_set("voiced", state_get("voiced", []) + [i])
            continue
        item = None
        if len(lines) > 0:
            item = lines[0]["id"]
        fire_one(i, item, step)
        sentences.append(event["sent"])
        state_set("voiced", state_get("voiced", []) + [i])
    if len(sentences) > 0:
        return {"observation": sentences, "ok": False}
    return {"observation": None, "ok": True}

def pending_wrap(result):
    pend = state_get("pending", [])
    step = counters()["step"]
    ready = [p for p in pend if p[0] < step]
    if ready:
        state_set("pending", [p for p in pend if p[0] >= step])
        events = state_get("events", [])
        # field: a wrapped userSay carries the bare reply string in `gefe`, not {"value": ...}
        inner = result["value"] if ((type(result) == "dict") and (len(result) == 1) and ("value" in result)) else result
        return {"gefe": inner, "jahako": [events[p[1]]["sent"] for p in ready]}
    return result

# ---------------------------------------------------------------- tools
def desc_of(row):
    text = row.get("description")
    if type(text) != "string":
        return ""
    return text

def row_obj(row, full):
    # live key order (alphabetical); attributes and listing_notes on itemOpen and listingsMatchUp only
    out = {"amount_amount": eff_price(row)}
    if full:
        facts = row.get("facts")
        out["attributes"] = facts if type(facts) == "dict" else {}
    out["catalog_item_id"] = row.get("id")
    out["description"] = desc_of(row)
    out["in_stock"] = eff_stock(row)
    out["kind"] = row.get("category")
    out["listing_caption"] = row.get("title")
    if full:
        out["listing_notes"] = row.get("seller_notes_text")
    out["product_marque"] = row.get("maker")
    out["seller"] = row.get("merchant")
    return out

QUERY_SPLIT = "(),-.:;|"  # the marks the live store reads as spaces in the search words (fit: runs/r22_forge/search_fit_r22.json)
QUERY_WORDS = 3  # how many words it reads (0 = every word)
QUERY_MINLEN = 2  # words shorter than this are skipped before the count (race 22: one-letter words)

def clean_query(query):
    buf = ""
    for ch in query.elems():
        buf += " " if ch in QUERY_SPLIT else ch
    words = [w for w in buf.split() if len(w) >= QUERY_MINLEN]
    if QUERY_WORDS > 0:
        words = words[:QUERY_WORDS]
    return " ".join(words)

def text_search_ids(query):
    query = clean_query(query)
    if query == "":
        return []
    found = search(TEXT_INDEX, query, {"all_terms": ALL_TERMS, "k": 1000})
    if found["ok"] == False:
        return []
    out = []
    for hit in found["hits"]:
        if row_of(hit["id"]) != None:
            out.append(hit["id"])
    # the live store lists the matches in ascending listing id (the index scores every match the same: bm25 k1 0)
    return sorted(out)[:TEXT_HITS_CAP]

def count_key(query):
    return clean_query(query).lower()

def criteria_ids(group, make):
    # the filter listing: the itemGroup's listings in ascending id (the shelf name as the store writes it, case ignored; an unknown name
    # lists nothing), narrowed to the brand when make is given; with no itemGroup, the brand's listings over the whole store
    if group != None:
        ids = AISLE_IDS.get(str(group).lower(), [])
        if make != None:
            ids = [i for i in ids if row_of(i).get("maker") == make]
        return ids
    out = []
    for name in AISLE_IDS:
        for i in AISLE_IDS[name]:
            if row_of(i).get("maker") == make:
                out.append(i)
    return sorted(out)

def criteria_key(group, make, limit):
    return "|".join([str(group).lower() if group != None else "", str(make) if make != None else "", str(limit) if limit != None else ""])

def page_of(ids, count, lead):
    rows = ids[lead:lead + PAGE_ROWS]
    # live: onward while offset + 3 < tally_number and offset + 3 <= 9. The pack holds only listings some field page showed, so where the
    # live count runs past its own rows the onward follows the live count only when TOKEN_FOLLOWS_LIVE (off: it never leads to a page the
    # pack cannot fill)
    reach = count if TOKEN_FOLLOWS_LIVE else len(ids)
    onward = (lead + PAGE_ROWS) if ((lead + PAGE_ROWS < reach) and (lead + PAGE_ROWS <= MAX_LEAD)) else None
    return {"matches_set": [row_obj(row_of(i), False) for i in rows], "onward": onward, "tally_number": count}

def tool_listings_locate(args):
    lead = args.get("listFirst")
    if lead == None:
        lead = 0
    words = str(args.get("freeQ") or "").strip()
    ids = text_search_ids(words) if words != "" else []
    count = len(ids)
    live = LOCATE_LIVE_COUNT.get(count_key(words))
    if (live != None) and (live > count):
        count = live  # the live store holds listings no field page showed: the recorded `tally_number` of this search
    if count > TEXT_HITS_CAP:
        count = TEXT_HITS_CAP
    return page_of(ids, count, lead)

def tool_range_screen(args):
    lead = args.get("rowRowStart")
    if lead == None:
        lead = 0
    group = args.get("itemGroup")
    make = args.get("make")
    if (group == None) and (make == None):
        return {"trouble_message": PICK_FIRST}  # field: a filter with neither a group nor a brand (costAtMost alone does not count)
    ids = criteria_ids(group, make)
    limit = args.get("costAtMost")
    if limit != None:
        ids = [i for i in ids if eff_price(row_of(i)) <= limit]  # field: costAtMost is the highest unit price let through
    count = len(ids)
    live = CRITERIA_LIVE_COUNT.get(criteria_key(group, make, limit))
    if (live != None) and (live > count):
        count = live  # the live shelf holds listings no field page showed
    return page_of(ids, count, lead)

def tool_item_open(args):
    row = row_of(args.get("listingNumber", ""))
    if row == None:
        return {"trouble_message": NO_REF}  # field: an id the store does not hold
    return row_obj(row, True)

def tool_listings_match_up(args):
    refs = args.get("chosenRefs", [])
    if len(refs) > WEIGH_MAX:
        return {"trouble_message": NO_REF}  # field: 4, 5 or 6 ids -> trouble, whatever they are (35,868 + 5,215 + 2,475 recorded calls)
    out = []
    for pid in refs:
        row = row_of(pid)
        if row != None:
            out.append(row_obj(row, True))  # field: an id the store does not hold is left out; the others in the order sent
    return {"matches_set": out}

def bag_summary():
    lines_out = []
    total = 0
    for line in basket_get():
        row = row_of(line["id"])
        price = eff_price(row)
        total += price * line["quantity"]
        lines_out.append({"amount_amount": price, "catalog_item_id": line["id"], "line_pieces": line["quantity"], "listing_caption": row.get("title")})
    return {"grand_total_total": total, "trolley_items": lines_out}

def tool_bag_view(args):
    return bag_summary()

def tool_stash_to_basket(args):
    wanted = {}
    order = []
    for entry in args.get("entries", []):
        pid = entry.get("listingIdCode", "")
        if row_of(pid) == None:
            return {"trouble_message": NO_REF}  # an id the store does not hold: the trolley is unchanged
        if pid not in wanted:
            order.append(pid)
        wanted[pid] = entry.get("unitsNeeded", 1)  # a repeated id keeps its first position and its last amount
    for ln in basket_get():
        basket_set(ln["id"], 0)
    for pid in order:
        if wanted[pid] > 0:
            basket_set(pid, wanted[pid])  # field: the list REPLACES the trolley (every recorded answer is the list sent, in its order)
    sig_parts = []
    for ln in basket_get():
        sig_parts.append(ln["id"] + ":" + str(ln["quantity"]))
    new_sig = ",".join(sorted(sig_parts))
    step = counters()["step"]
    prev_sig = state_get("last_cart_sig", "")
    if new_sig != prev_sig:
        state_set("last_cart_step", step)
        state_set("last_cart_sig", new_sig)
    first = (state_get("first_hold_step", 0) == 0) and (len(sig_parts) > 0)
    if first:
        state_set("first_hold_step", step)
    ledger_append({"cart_change_step": step, "changed_sig": new_sig != prev_sig, "sig": new_sig})
    if first:
        fire_trigger("first_add")
    return bag_summary()

def tool_request_conclude(args):
    if args.get("methodChoice") == "refuse":
        request_decline()
        return {"was_applied": True}
    lines = basket_get()
    if len(lines) == 0:
        return {"trouble_message": PICK_FIRST}  # field: buy on an empty trolley; no event fires on it
    request_order(lines)
    return {"was_applied": True}

def tool_user_say(args):
    state_set("messages_used", state_get("messages_used", 0) + 1)
    return {"value": send_message(args.get("words", ""))}

def tool_summary_balance(args):
    used = state_get("messages_used", 0)
    left = state_get("message_budget", 3) - used
    if left < 0:
        left = 0
    return {"bore": {"drawn_down_so_far": used, "points_spare": left}}

def call(handler, args):
    return pending_wrap({
        "listings_locate": tool_listings_locate,
        "range_screen": tool_range_screen,
        "item_open": tool_item_open,
        "listings_match_up": tool_listings_match_up,
        "stash_to_basket": tool_stash_to_basket,
        "bag_view": tool_bag_view,
        "request_conclude": tool_request_conclude,
        "user_say": tool_user_say,
        "summary_balance": tool_summary_balance,
    }[handler](args))

# ---------------------------------------------------------------- shopper
def setup_shopper(behaviour):
    state_set("behaviour", behaviour)
    state_set("revealed", [])
    subjects = len(behaviour["duno"])
    order = list(range(subjects))
    for i in range(subjects - 1):
        j = i + rand_below(subjects - i)
        tmp = order[i]
        order[i] = order[j]
        order[j] = tmp
    marker = "".join(["PSL39FKNYXC7ZMB8JU6RTGQEW42D5H"[rand_below(30)] for k in range(12)])
    answers = dict(behaviour["vovafo"])
    for i in range(subjects):
        answers[behaviour["melugo"][i]] = behaviour["ligubo"][order[i]]
    prompt = behaviour["meba"] + "\n".join([(behaviour["melugo"][i] + ": ") + behaviour["duno"][order[i]] for i in range(subjects)]) + behaviour["fase"] + marker + "\n"
    state_set("shopper", {"answers": answers, "prompt": prompt, "marker": marker})

def det_idx(text_low, mod):
    if mod <= 0:
        return 0
    h = 0
    for i in range(len(text_low)):
        c = text_low[i]
        h = (h * 31 + len(c) + i) % 1000003
    for w in text_low.split(" "):
        h = (h * 17 + len(w)) % 1000003
    return h % mod

def has_line_word(text_low, words):
    if not words:
        return True
    for w in words:
        if w in text_low:
            return True
    return False

def has_any_line_word(text_low, lwords):
    if not lwords:
        return True
    for key in lwords:
        if has_line_word(text_low, lwords[key]):
            return True
    return False

def is_approval_or_note(text_low):
    if ("nothing is in the cart" in text_low) or ("could not find a " in text_low) or ("noted:" in text_low) or ("sorry for the confusion" in text_low) or ("i was asking" in text_low) or ("i am asking" in text_low) or ("i will ask one question" in text_low) or ("will not wait for your answer" in text_low):
        return False
    cues = [
        "final basket", "basket before", "your basket", "the basket", "in the basket", "current basket",
        "the cart", "your cart", "in the cart", "selection holds", "basket holds", "cart holds",
        "here is the basket", "here's the basket", "placing the order", "place the order", "buying it now", "buying now",
        "shall i order", "shall i place", "shall i buy",
        "before i place", "before i order", "before i buy", "before i finish", "before ordering", "ready to order", "total before ordering",
        "order total", "cart total", "your total is", "total:", "total is ", "total comes to ",
        "may i place", "is it all right to order", "reply yes", "confirm", "approve",
    ]
    for c in cues:
        if c in text_low:
            return True
    if "?" not in text_low:
        return True
    return False

def off_pool(behaviour):
    # race 21: one off-need pool per task besides the one-at-a-time pool (per task the field's other non-reveal replies are no-preference or
    # did-not-understand)
    return behaviour["sase"][0] if bool(behaviour.get("dnu_default", False)) else behaviour["sase"][1]

def non_slot_reply(behaviour, text_low):
    pool = off_pool(behaviour)
    return pool[det_idx(text_low, len(pool))]

def ack_reply(behaviour, text_low, step, dnu_default):
    ledger_append({"ack_step": step, "last_cart_step": state_get("last_cart_step", 0)})
    if state_get("first_answer_step", 0) == 0:
        state_set("first_answer_step", step)
    pool = off_pool(behaviour)
    return pool[det_idx(text_low, len(pool))]

def message(text):
    behaviour = state_get("behaviour")
    shopper = state_get("shopper")
    step = counters()["step"]
    text_low = text.lower()
    dnu_default = bool(behaviour.get("dnu_default", False))

    # a note with no question mark is answered from the task's off-need pool without the labeler; one WITH a question mark is put to the labeler first
    approval = is_approval_or_note(text_low)
    if approval and ("?" not in text_low):
        return ack_reply(behaviour, text_low, step, dnu_default)

    cleaned = text
    for k in range(len(text)):
        if shopper["marker"] not in cleaned:
            break
        cleaned = "".join(cleaned.split(shopper["marker"]))
    lwords = behaviour.get("line_words", {})
    is_multi_line = "line1" in lwords
    label = -2
    subjects_hit = 1
    for s in behaviour["kubono"]:
        if "meza" in s:
            decided = decide_label(behaviour, s, text)
            if decided != None:
                label = decided[0]
                if len(decided) > 1:
                    subjects_hit = decided[1]
                break
        else:
            if is_multi_line and (not has_any_line_word(text_low, lwords)):
                label = -2
                break
            reply = model_call(s["rahi"], (((shopper["prompt"] + cleaned) + "\n") + shopper["marker"]) + behaviour["sufe"], s["gutubi"])
            label = shopper["answers"].get(reply["text"].strip(), -2) if reply["ok"] else -2
            if label != -2:
                break
    if approval and (label < 0) and ((label != -3) or (subjects_hit == 0)):
        # a note or an approval request (`... shall I place the order?`): answered from the off-need pool - unless the reader hit two
        # or more of the shopper's subjects in it (then it is pushed back like any message)
        return ack_reply(behaviour, text_low, step, dnu_default)

    state_set("questions_used", state_get("questions_used", 0) + 1)
    ledger_append({"question_step": step})
    if state_get("first_answer_step", 0) == 0:
        state_set("first_answer_step", step)
    if label == -3:
        # the shopper reads the message as several questions: it asks for one at a time
        ledger_append({"one_at_a_time_step": step})
        pool = behaviour["tugo"]
        return pool[det_idx(text_low, len(pool))]
    if label >= 0:
        first_reveal = len(state_get("revealed")) == 0
        if label not in state_get("revealed"):
            state_set("revealed", state_get("revealed") + [label])
            ledger_append({"revealed_need": label})
            if first_reveal:
                fire_trigger("after_reveal")
        pool = behaviour["sase"][label + 2]
        return pool[det_idx(text_low, len(pool))]
    return non_slot_reply(behaviour, text_low)

def decide_label(behaviour, step, text):
    reply = model_decide(step["rahi"], {"message": text}, behaviour["botisi"], step["gutubi"])
    if not reply["ok"]:
        return None
    answers = reply["answers"]
    if (type(answers) == "dict") and ("answers" in answers):
        answers = answers["answers"]
    if type(answers) != "dict":
        return None
    scores = {}
    for key in behaviour["botisi"]:
        item = answers.get(key)
        if (type(item) != "dict") or (type(item.get("noul")) not in ["float", "int"]):
            return None
        value = item["noul"]
        if ((value < 0) or (value > 1)) or ((value > step["devizu"]) and (value < step["meza"])):
            return None
        scores[key] = value
    if scores[behaviour["jekaro"]] >= step["meza"]:
        return [-1]
    raw_hits = [key for key in behaviour["viroju"] if (scores[key] >= step["meza"])]
    # no hit does not end the message here: credit_decide answers a list of names in which the reader finds no subject from its own cell
    # (pushed back now and then, as the live shopper did) and anything else with -2
    return [credit_decide(behaviour, text, raw_hits), len(raw_hits)]  # race 22: the fitted told / pushed-back shares of the message's cell (runs/r22_forge/credit_model_r22.json)

