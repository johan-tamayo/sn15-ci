+|own|h2+": [0.0032, 0.9968], "MLn|u|k1|c1|off|h1": [0.0, 0.0713], "MLn|u|k1|c1|off|h2+": [0.0, 0.0], "MLn|u|k1|c1|own|h1": [0.8563, 0.1269], "MLn|u|k1|c1|own|h2+": [0.0305, 0.9672], "MLn|u|k1|c2+|off|h1": [0.0, 0.0713], "MLn|u|k1|c2+|off|h2+": [0.0, 0.0], "MLn|u|k1|c2+|own|h1": [0.8563, 0.1269], "MLn|u|k1|c2+|own|h2+": [0.0305, 0.9672], "MLn|u|k2-3|c1|off|h1": [0.0, 0.0713], "MLn|u|k2-3|c1|off|h2+": [0.0, 0.136], "MLn|u|k2-3|c1|own|h1": [0.9632, 0.0368], "MLn|u|k2-3|c1|own|h2+": [0.0032, 0.9968], "MLn|u|k2-3|c2+|off|h1": [0.0, 0.0713], "MLn|u|k2-3|c2+|off|h2+": [0.0, 0.136], "MLn|u|k2-3|c2+|own|h1": [0.9588, 0.0412], "MLn|u|k2-3|c2+|own|h2+": [0.0032, 0.9968], "MLn|u|k4-6|c1|off|h1": [0.0, 0.0713], "MLn|u|k4-6|c1|off|h2+": [0.0, 0.2352], "MLn|u|k4-6|c1|own|h1": [0.9632, 0.0368], "MLn|u|k4-6|c1|own|h2+": [0.0029, 0.9971], "MLn|u|k4-6|c2+|off|h1": [0.0, 0.0713], "MLn|u|k4-6|c2+|off|h2+": [0.0, 0.2352], "MLn|u|k4-6|c2+|own|h1": [0.9588, 0.0412], "MLn|u|k4-6|c2+|own|h2+": [0.0032, 0.9968], "MLn|u|k7+|c1|off|h1": [0.0, 0.0713], "MLn|u|k7+|c1|off|h2+": [0.0, 0.1335], "MLn|u|k7+|c1|own|h1": [0.9632, 0.0368], "MLn|u|k7+|c1|own|h2+": [0.0029, 0.9971], "MLn|u|k7+|c2+|off|h1": [0.0, 0.0713], "MLn|u|k7+|c2+|off|h2+": [0.0, 0.1335], "MLn|u|k7+|c2+|own|h1": [0.9588, 0.0412], "MLn|u|k7+|c2+|own|h2+": [0.0032, 0.9968]}
CREDIT21_ASK = ["what ", "which "]
CREDIT21_LEADS = ["do you want for ", "do you need for ", "would you like for ", "do you want in ", "do you want on "]
CREDIT21_MARKS = [" would you like", " do you want", " do you need", " do you prefer", " should ", " are you ", " is ", " for the ", " for your "]
CREDIT21_NEXT = ["what ", "which ", "how many ", "how much ", "do you ", "would you ", "should "]
# questions that carry their names behind another opening than what / which: `Do you have a preference on A, B or C for the X?`, `Do you
# need a particular A in the X?`, `How much A do you need?`, `... or does the A or the B matter?` - the names run from the opening to the
# first of the marks
CREDIT21_OPEN = ["preference on the ", "preference on ", "preference for the ", "preference for ", "preferences on ", "preferences for ", "particular ", "specific ",
                 "how much ", "how many ", "does the "]
CREDIT21_OPEN_MARKS = [" for the ", " of the ", " on the ", " in the ", " for your ", " for my ", " would you", " do you", " should ", " matter"]
CREDIT21_GLUE = [", ", "; ", " and ", " also "]
CREDIT21_JOIN = ["and", "or", "the", "of", "for", "a", "an", "s"]
CREDIT21_PREP = ["of", "for", "on", "in"]
CREDIT21_SPELL = {"colour": "color", "colours": "colors", "flavour": "flavor"}

def credit_draw(idx):
    x = (state_get("credit_seed", 0) * 2654435761 + idx * 40503 + 12345) % 4294967296
    x = ((x ^ (x >> 16)) * 2246822519) % 4294967296
    x = ((x ^ (x >> 13)) * 3266489917) % 4294967296
    x = x ^ (x >> 16)
    return x % 10000

def credit_tokens(ql):
    out = []
    cur = ""
    start = -1
    for i in range(len(ql)):
        ch = ql[i]
        if ch.isalnum():
            if start < 0:
                start = i
            cur += ch
        else:
            if start >= 0:
                out.append([start, cur])
            cur = ""
            start = -1
    if start >= 0:
        out.append([start, cur])
    return out

def credit_stem(w):
    w = CREDIT21_SPELL.get(w, w)
    if (len(w) > 3) and w.endswith("s"):
        return w[:-1]
    return w

def credit_stems(text):
    return [credit_stem(t[1]) for t in credit_tokens(text.lower().replace("_", " "))]

def credit_has_phrase(hay, needle):
    # the stems of `needle` stand in `hay` as a run
    n = len(needle)
    if n == 0:
        return False
    for i in range(len(hay) - n + 1):
        if hay[i:i + n] == needle:
            return True
    return False

def credit_same(a, b):
    return credit_has_phrase(a, b) or credit_has_phrase(b, a)

def credit_clauses(ql):
    # the question clauses of a message, in order: cut at question marks and at a new asking word after a comma, a semicolon, `and` or `also`
    out = []
    for part in ql.split("?"):
        cuts = []
        for glue in CREDIT21_GLUE:
            for word in CREDIT21_NEXT:
                pat = glue + word
                at = part.find(pat)
                for tick in range(40):
                    if at < 0:
                        break
                    cuts.append([at, at + len(glue)])
                    at = part.find(pat, at + 1)
        prev = 0
        for c in sorted(cuts):
            if c[0] < prev:
                continue
            seg = part[prev:c[0]].strip()
            if seg != "":
                out.append(seg)
            prev = c[1]
        seg = part[prev:].strip()
        if seg != "":
            out.append(seg)
    return out

def credit_clause_names(cl):
    # the property names of one question, in order: `what A, B or C would you like ...` (between the asking word and the verb),
    # `what do you want for A, B and C` (after the verb phrase), or - with no what / which - the names behind another opening
    # (`a preference on A, B or C`, `a particular A`, `how much A`, `does the A or the B matter`)
    start = -1
    skip = 0
    for ask in CREDIT21_ASK:
        i = cl.find(ask)
        if (i >= 0) and ((start < 0) or (i < start)):
            start = i
            skip = len(ask)
    body = None
    if start < 0:
        for lead in CREDIT21_OPEN:
            i = cl.find(lead)
            if i >= 0:
                rest = cl[i + len(lead):]
                end = len(rest)
                for mark in CREDIT21_OPEN_MARKS:
                    j = rest.find(mark)
                    if (j >= 0) and (j < end):
                        end = j
                body = rest[:end]
                break
        if body == None:
            return []
    else:
        rest = cl[start + skip:]
        for lead in CREDIT21_LEADS:
            if rest.startswith(lead):
                body = rest[len(lead):]
                break
        if body == None:
            end = len(rest)
            for mark in CREDIT21_MARKS:
                j = rest.find(mark)
                if (j >= 0) and (j < end):
                    end = j
            body = rest[:end]
    names = []
    for chunk in body.split(","):
        for piece in chunk.split(" and "):
            for name in piece.split(" or "):
                name = name.strip()
                if name.startswith("the "):
                    name = name[4:].strip()
                if (name != "") and (len(name.split()) <= 8):
                    names.append(name)
    return names

def credit_name_parts(ql, behaviour = None):
    # [[name stems, question index]...] for every name the message asks about, in order
    out = []
    cls = credit_clauses(ql)
    for ci in range(len(cls)):
        for name in credit_clause_names(cls[ci]):
            out.append([credit_stems(name), ci])
    return out

def credit_fold(t):
    if (len(t) > 4) and t.endswith("ies"):
        return t[:-3] + "y"
    if (len(t) > 3) and t.endswith("es"):
        base = t[:-2]
        if base.endswith("ss") or base.endswith("x") or base.endswith("z") or base.endswith("ch") or base.endswith("sh"):
            return base
    if (len(t) > 2) and t.endswith("s") and (not t.endswith("ss")):
        return t[:-1]
    return t

def credit_words(text):
    return [credit_fold(t[1]) for t in credit_tokens(text.lower())]

def credit_item_words(cl):
    # the words of a question that can name an ITEM: every word but those of its property names - `drive type`, `laptop size` are
    # properties whatever shelf word they hold; of a name, only what follows `of`, `for`, `on` or `in` can name an item (`size of the
    # laptop sleeves`).  Field: `For the internal ssds, what form factor, drive type or interface would you like?` was told (19 such
    # told replies on tasks that also hold internal hard drives or windows laptops)
    drop = []
    for name in credit_clause_names(cl):
        for tok in name.split(" "):
            if tok in CREDIT21_PREP:
                break
            for w in credit_words(tok):
                drop.append(w)
    used = [False for d in drop]
    out = []
    for w in credit_words(cl):
        hit = False
        for i in range(len(drop)):
            if (not used[i]) and (drop[i] == w):
                used[i] = True
                hit = True
                break
        if not hit:
            out.append(w)
    return out

def credit_lines_named(words, lwords):
    # the lines (`line0`, ..) a text names: it holds carrying words of the line's shelf name (plural or singular, any joiner: `internal
    # hard drive`, `screen protector`, `laptop` for `windows laptops`); a line whose held words all belong to another named line's
    # (`laptop` inside `laptop sleeve`), or are the same words and a smaller part of its own name, does not count
    held = {}
    share = {}
    for lk in lwords:
        if not lk.startswith("line"):
            continue
        for w in lwords[lk]:
            carry = [c for c in credit_words(str(w)) if c not in CREDIT21_JOIN]
            got = [c for c in carry if c in words]
            if (len(carry) > 0) and (len(got) > 0):
                s = (1.0 * len(got)) / len(carry)
                if (lk not in held) or (s > share[lk]):
                    held[lk] = got
                    share[lk] = s
    out = []
    for lk in held:
        beaten = False
        for other in held:
            if other == lk:
                continue
            inside = True
            for w in held[lk]:
                if w not in held[other]:
                    inside = False
            if inside and ((len(held[other]) > len(held[lk])) or (share[other] > share[lk])):
                beaten = True
        if not beaten:
            out.append(lk)
    return out

def credit_prop(behaviour, key):
    parts = str(behaviour["botisi"][key]["instructions"]).split("'")
    if len(parts) >= 3:
        return parts[-2]
    return ""

def credit_own_lines(lwords, key):
    own = lwords.get(key, [])
    return [lk for lk in lwords if lk.startswith("line") and (lwords[lk] == own)]

def credit_clause_lines(cls, lwords):
    # the lines each question is about: the lines its own words name (the words of its property names apart: credit_item_words); a
    # question that names none takes those of the nearest question before it that names one (`For the X, what A?` is cut into the item
    # and the question), else of the nearest one after it
    raw = [credit_lines_named(credit_item_words(c), lwords) for c in cls]
    out = []
    for i in range(len(raw)):
        got = raw[i]
        if len(got) == 0:
            for j in range(i - 1, -1, -1):
                if len(raw[j]) > 0:
                    got = raw[j]
                    break
        if len(got) == 0:
            for j in range(i + 1, len(raw)):
                if len(raw[j]) > 0:
                    got = raw[j]
                    break
        out.append(got)
    return out

def credit_locate(ql, behaviour, key, parts = None, cl_lines = None):
    # where the subject is asked: [place among the names (-1: not among them), question index, item context, names, named]
    lwords = behaviour.get("line_words", {})
    multi = "line1" in lwords
    if parts == None:
        parts = credit_name_parts(ql, behaviour)
    prop = credit_stems(credit_prop(behaviour, key))
    cands = [i for i in range(len(parts)) if credit_same(parts[i][0], prop)]
    named = (len(cands) > 0) or credit_has_phrase(credit_stems(ql), prop)
    k = len(parts)
    if k < 1:
        k = 1
    if not multi:
        if len(cands) > 0:
            return [cands[0], parts[cands[0]][1], "own", k, named]
        return [-1, 0, "own", k, named]
    own = credit_own_lines(lwords, key)
    if cl_lines == None:
        cl_lines = credit_clause_lines(credit_clauses(ql), lwords)
    for i in cands:
        ci = parts[i][1]
        about = cl_lines[ci] if ci < len(cl_lines) else []
        if len(about) == 0:
            return [i, ci, "own", k, named]  # no question of the message names an item
        for lk in about:
            if lk in own:
                return [i, ci, "own", k, named]
    if len(cands) > 0:
        return [cands[0], parts[cands[0]][1], "off", k, named]
    any_line = False
    msg_own = False
    for about in cl_lines:
        for lk in about:
            any_line = True
            if lk in own:
                msg_own = True
    return [-1, 0, "own" if (msg_own or (not any_line)) else "off", k, named]

def credit_pb(place):
    if place < 0:
        return "u"
    if place == 0:
        return "p1"
    if place == 1:
        return "p2"
    if place == 2:
        return "p3"
    if place <= 4:
        return "p4-5"
    return "p6+"

def credit_kb(k):
    if k <= 1:
        return "k1"
    if k <= 3:
        return "k2-3"
    if k <= 6:
        return "k4-6"
    return "k7+"

def credit_tier(behaviour):
    if "line1" not in behaviour.get("line_words", {}):
        return "1L"
    return "MLd" if bool(behaviour.get("dnu_default", False)) else "MLn"

def credit_hb(n):
    if n <= 1:
        return "h1"
    return "h2+"

def credit_cell(behaviour, text, hit_keys):
    # [cell key, the need a told reply reveals (-2 when the reader hit no need)] of a message, or None (off-need: no subject hit, fewer than two names):
    # the first need in reading order (asked with its own item before one asked with another; then by place; a need not found among the
    # names last); with no need hit, the cell of a message about subjects the shopper has no view on
    ql = text.lower()
    parts = credit_name_parts(ql, behaviour)
    if len(hit_keys) == 0:
        # the reader hit no subject: a message that lists two or more names can still be pushed back (the live shopper holds subjects the
        # pack does not know; race 21 pushed 7 such messages in 100 back) - the cell of the names it carries; anything else is off-need
        if len(parts) < 2:
            return None
        return ["|".join([credit_tier(behaviour), "n", credit_kb(len(parts)), "c1", "own", "h0"]), -2]
    cl_lines = credit_clause_lines(credit_clauses(ql), behaviour.get("line_words", {}))
    hb = credit_hb(len(hit_keys))
    best = None
    for key in hit_keys:
        label = behaviour["viroju"][key]
        if label < 0:
            continue
        loc = credit_locate(ql, behaviour, key, parts, cl_lines)
        rank = [1 if loc[2] == "off" else 0, loc[0] if loc[0] >= 0 else 1000, label]
        if (best == None) or (rank < best[0]):
            best = [rank, label, loc]
    if best == None:
        k = len(parts)
        if k < 1:
            k = 1
        return ["|".join([credit_tier(behaviour), "d", credit_kb(k), "c1", "own", hb]), -2]
    loc = best[2]
    place = loc[0]
    if (place < 0) and (len(parts) <= 1) and (len(hit_keys) == 1):
        # one subject hit and no list of names read: the need is asked ALONE, in a wording the name reader does not parse
        # (`Would a certain tea format suit you?`) - the place of a need named first
        place = 0
    cb = "c1"
    if loc[0] >= 0:
        first = parts[0][1] if len(parts) > 0 else 0
        if loc[1] > first:
            cb = "c2+"
    return ["|".join([credit_tier(behaviour), credit_pb(place), credit_kb(loc[3]), cb, loc[2], hb]), best[1]]

def credit_solo(behaviour, cell, hit_keys):
    # a need asked ALONE (one name, the first question, its own item, one subject hit): the race's own [told, pushed back] for THIS need
    # when the task carries it (`solo`: {subject key: [told, pushed back]}; race 21 told such a question 100% on every need but one,
    # whose plain question was pushed back two times in three)
    if cell[1] < 0:
        return None
    parts = cell[0].split("|")
    if (parts[1] != "p1") or (parts[2] != "k1") or (parts[3] != "c1") or (parts[4] != "own") or (parts[5] != "h1"):
        return None
    solo = behaviour.get("solo", {})
    for key in hit_keys:
        if (behaviour["viroju"][key] == cell[1]) and (key in solo):
            return solo[key]
    return None

def credit_pair(behaviour, cell, hit_keys):
    pair = credit_solo(behaviour, cell, hit_keys)
    if pair == None:
        pair = CREDIT21_TABLE.get(cell[0], [0.0, 0.0])
    return pair

def credit_decide(behaviour, text, hit_keys):
    # the need told (>= 0), -3 (the one-at-a-time pool) or -2 (the task's off-need pool): the fitted [told, pushed back] of the message's
    # cell (the need's own shares when it is asked alone) against two draws (told first, then one at a time among what is left)
    cell = credit_cell(behaviour, text, hit_keys)
    if cell == None:
        return -2
    pair = credit_pair(behaviour, cell, hit_keys)
    idx = state_get("messages_used", 0)
    told = pair[0]
    if cell[1] >= 0:
        u1 = credit_draw(idx) / 10000.0
        if u1 < told:
            return cell[1]
    else:
        told = 0.0
    rest = 1.0 - told
    u2 = credit_draw(100 + idx) / 10000.0
    if (rest > 0) and (u2 < pair[1] / rest):
        return -3
    return -2

# ---------------------------------------------------------------- grading
def price_of(prices, ov, item_id):
    if item_id in ov:
        return ov[item_id]
    if item_id in prices:
        return prices[item_id]
    row = catalog_get(item_id)
    return row.get("price", 0) if row != None else 0

def order_total(lines, prices, ov):
    total = 0
    for line in lines:
        total += price_of(prices, ov, line["id"]) * line["quantity"]
    return total

def fits_pair_ok(a_id, b_id, pair):
    allowed = pair["ok"].get(a_id)
    return (allowed == None) or (b_id in allowed)

def lines_claim_answer_lines(lines, answer_lines, key, gone, fitok = []):
    # can the order's lines be matched one to one with the wanted lines (a wanted line takes one order line: a listing of its list, not sold
    # out, the wanted quantity) so that every cross-line rule holds? Backtracking over the wanted lines with an explicit stack (Starlark has
    # no recursion): race 21 has six-line tasks, and the search stops at the first wanted line no order line can stand for instead of
    # walking all 720 orders of the lines.
    n = len(lines)
    if n != len(answer_lines):
        return False
    cand = []
    for i in range(n):
        target = answer_lines[i]
        row = []
        for j in range(n):
            ln = lines[j]
            if (ln["id"] in target[key]) and (ln["id"] not in gone) and (ln["quantity"] == target["kudi"]):
                row.append(j)
        if len(row) == 0:
            return False
        cand.append(row)
    choice = [-1 for i in range(n)]
    picked = [-1 for i in range(n)]
    i = 0
    for tick in range(20000):
        if i == n:
            return True
        if i < 0:
            return False
        choice[i] += 1
        if choice[i] >= len(cand[i]):
            choice[i] = -1
            picked[i] = -1
            i -= 1
            continue
        j = cand[i][choice[i]]
        if j in picked[:i]:
            continue
        ok = True
        for pair in fitok:
            a = pair["a"]
            b = pair["b"]
            if (a == i) and (b < i):
                if not fits_pair_ok(lines[j]["id"], lines[picked[b]]["id"], pair):
                    ok = False
                    break
            if (b == i) and (a < i):
                if not fits_pair_ok(lines[picked[a]]["id"], lines[j]["id"], pair):
                    ok = False
                    break
        if not ok:
            continue
        picked[i] = j
        i += 1
    return False

def cheapest_total(slot, ov, gone):
    # the lowest total of an acceptable basket left: per line the cheapest listing not sold out (a slot that carries cross-line rules keeps
    # its own figure - `jufuli` - as the floor: the builder priced it with the rules)
    total = 0
    for line in slot["tufa"]:
        best = None
        for pid in line["lita"]:
            if pid in gone:
                continue
            c = price_of(slot["fari"], ov, pid) * line["kudi"]
            if (best == None) or (c < best):
                best = c
        if best == None:
            return None
        total += best
    return total

def accepted(slot, lines, reason, key, ov, gone, dyn):
    if reason == "decline":
        if slot.get("nodecline", False):
            return False
        if not dyn:
            return slot["tele"]
        if slot["tele"]:
            return True
        cheapest = cheapest_total(slot, ov, gone)
        return (cheapest == None) or (cheapest > slot["suhe"])
    return lines_claim_answer_lines(lines, slot["tufa"], key, gone, slot.get("fitok", [])) and (order_total(lines, slot["fari"], ov) <= slot["suhe"])

def process_complete(episode, answer, slot, reason):
    opened = {}
    revealed = {}
    for record in episode:
        if record["kind"] == "action":
            tool = record.get("tool")
            args = record.get("args")
            if type(args) != "dict":
                continue
            if tool == "itemOpen":
                opened[args.get("listingNumber", "")] = True
            elif tool == "listingsMatchUp":
                refs = args.get("chosenRefs", [])
                if (type(refs) == "list") and (len(refs) <= 3):
                    for r in refs:
                        opened[r] = True  # field: a listing laid out by the batch view counts as opened (42 PASS + 115 not-the-best orders)
        elif record["kind"] == "event":
            data = record["data"]
            if (type(data) == "dict") and ("revealed_need" in data):
                revealed[data["revealed_need"]] = True
    # reference chains the request states: every page of the chain opened; a chain whose property the store dropped is waived (slot.refs_off)
    off = slot.get("refs_off", [])
    refs = answer.get("refs", [])
    for k in range(len(refs)):
        if k in off:
            continue
        for item_id in refs[k]:
            if item_id not in opened:
                return False
    if reason == "order":
        # field: every hidden need revealed, the chain of a need revealed by reference opened, and every ordered listing opened (itemOpen or
        # listingsMatchUp) at some point - a listing put on the trolley off a search row alone is process-missed
        for chain in answer.get("need_refs", []):
            for item_id in chain:
                if item_id not in opened:
                    return False
        for label in range(answer.get("needs", 0)):
            if label not in revealed:
                return False
        for line in episode[-1]["order"]["lines"]:
            if line["id"] not in opened:
                return False
    return True

def grade(episode, answer):
    last = episode[-1]
    reason = last["reason"]
    if (reason != "order") and (reason != "decline"):
        return {"category": "did not finish", "score": 0}
    lines = last["order"]["lines"] if (reason == "order") else []
    ov = {}
    gone = []
    mask = 0
    for record in episode:
        if record["kind"] == "event":
            data = record["data"]
            if (type(data) == "dict") and ("situ" in data):
                mask = mask + [1, 2, 4, 8, 16, 32][data["situ"]]
                if data.get("item") != None:
                    if data.get("price_to") != None:
                        ov[data["item"]] = data["price_to"]
                    if data.get("kind") == "stock":
                        gone.append(data["item"])
    fired = mask != 0
    dova = answer["dova"]
    slot = dova[mask] if mask < len(dova) else dova[0]
    dyn = bool(answer.get("dynamic", False))
    if reason == "order":
        # field: a decline is never process-missed
        if not process_complete(episode, answer, slot, reason):
            return {"category": "process requirement missed", "score": 0}
    jufuli = slot["jufuli"]
    if slot.get("cheapest", False) and ((len(gone) > 0) or (len(ov) > 0)):
        # the store sold out or repriced a listing: the lowest total is the cheapest acceptable basket LEFT, never below the slot's own figure
        left = cheapest_total(slot, ov, gone)
        if (left != None) and (left > jufuli):
            jufuli = left
    verdict = 1 if accepted(slot, lines, reason, "lita", ov, gone, dyn and fired) else 0
    if (verdict == 1) and (reason == "order") and (order_total(lines, slot["fari"], ov) > jufuli):
        verdict = 2
    if verdict == 1:
        return {"category": None, "score": 1}
    # race 22 has no `needs not found` label: an order that meets what the request states and misses a revealed need is `request not met`;
    # an order the store's notice pushed over the cap is `request not met` too (1 `changes missed` order in the whole field)
    if verdict == 2:
        return {"category": "not the best option", "score": 0}
    return {"category": "request not met", "score": 0}

# live `found_number` of the recorded keyword searches: "<the query as the store reads it>" -> found_number (runs/r22_forge/r22_search_counts.json), the
# live count of every recorded filter listing ("<aisle>|<brand>|<limit>"), and the aisles' own listings (ascending id). Kept at the END of the
# module: simrace/world_sim.py reads the text between an index name and the next def to tell which fields the index covers.
