def credit19_kb(k):
    if k <= 1:
        return "k1"
    if k <= 3:
        return "k2-3"
    if k <= 6:
        return "k4-6"
    return "k7+"

def credit19_pos(o, k):
    if o < 0:
        return "unplaced"
    if o == 0:
        return "first"
    if o >= k - 1:
        return "last"
    return "middle"

def credit_prop(behaviour, key):
    parts = str(behaviour["botisi"][key]["instructions"]).split("'")
    if len(parts) >= 3:
        return parts[-2]
    return ""

def credit_ctx(toks, behaviour, key, k):
    lwords = behaviour.get("line_words", {})
    if "line1" not in lwords:
        return "1L"
    m = credit_shelf_matches(toks, lwords, lwords.get(key, []))
    own = m[0]
    other = m[1]
    if own and other:
        if k == 1:
            return "own+other k1"
        return "own+other list"
    if own:
        return "own"
    if other:
        return "other"
    return "neither"

def credit_decide(behaviour, text, hit_keys):
    # race 19 (runs/r19_forge/credit_model_r19.json): the cell of the message -> [told, one-at-a-time]; returns the need told (>= 0),
    # -3 (the one-at-a-time pool) or -2 (the task's off-need pool)
    ql = text.lower()
    parts = credit_name_parts(ql, behaviour)
    k = len(parts)
    if k < 1:
        k = 1
    toks = credit_tokens(ql)
    hits = []
    for key in hit_keys:
        label = behaviour["viroju"][key]
        pos = credit_phrase_pos(toks, credit_prop(behaviour, key))
        ordinal = -1
        if pos >= 0:
            for i in range(len(parts)):
                if (parts[i][0] <= pos) and (pos < parts[i][1]):
                    ordinal = i
        ctx = credit_ctx(toks, behaviour, key, k)
        if ordinal < 0:
            rank = 1000000000 + (pos if pos >= 0 else 0)
        else:
            rank = ordinal * 100000 + pos
        hits.append([rank, key, label, ordinal, ctx])
    hits = sorted(hits)
    tier = "ML" if ("line1" in behaviour.get("line_words", {})) else "1L"
    need = None
    for h in hits:
        if h[2] >= 0:
            need = h
            break
    if len(hits) == 0:
        shape = "none"
    elif hits[0][2] >= 0:
        shape = "need" if len(hits) == 1 else "need+"
    elif need != None:
        shape = "decoy+need"
    else:
        shape = "decoy" if len(hits) == 1 else "decoys"
    ref = need if need != None else (hits[0] if len(hits) > 0 else None)
    pos_c = credit19_pos(need[3], k) if need != None else "-"
    ctx_c = "-"
    if ref != None:
        ctx_c = "own" if ref[4] in ["own", "1L"] else "off"
    cell = CREDIT19_TABLE["|".join([tier, shape, credit19_kb(k), pos_c, ctx_c])]
    told = cell[0]
    u1 = credit_draw(state_get("messages_used", 0)) / 10000.0
    if (need != None) and (u1 < told):
        return need[2]
    rest = 1.0 - told
    u2 = credit_draw(100 + state_get("messages_used", 0)) / 10000.0
    if (rest > 0) and (u2 < cell[1] / rest):
        return -3
    return -2

# ---------------------------------------------------------------- grading
OPEN_TOOLS = {"showPage": "listingNumber", "matchUpItems": "pickedRefs"}  # the calls that open a listing's page (field: a listing seen only in the batch view counts, 111 of 111 orders)

def price_of(prices, ov, item_id):
    if item_id in ov:
        return ov[item_id]
    if item_id in prices:
        return prices[item_id]
    row = catalog_get(item_id)
    return row.get("price", 0) if row != None else 0

def order_total(lines, prices, ov):
    total = 0
    for line in lines:
        total += price_of(prices, ov, line["id"]) * line["quantity"]
    return total

def fits_pair_ok(a_id, b_id, pair):
    allowed = pair["ok"].get(a_id)
    return (allowed == None) or (b_id in allowed)

def lines_claim_answer_lines(lines, answer_lines, key, gone, fitok = []):
    # can the order's lines be matched one to one with the wanted lines (a wanted line takes one order line: a listing of its list, not sold
    # out, the wanted quantity) so that every cross-line rule holds? Backtracking over the wanted lines with an explicit stack (Starlark has
    # no recursion): race 19 has a six-line task, and the search stops at the first wanted line no order line can stand for instead of
    # walking all 720 orders of the lines.
    n = len(lines)
    if n != len(answer_lines):
        return False
    cand = []
    for i in range(n):
        target = answer_lines[i]
        row = []
        for j in range(n):
            ln = lines[j]
            if (ln["id"] in target[key]) and (ln["id"] not in gone) and (ln["quantity"] == target["kudi"]):
                row.append(j)
        if len(row) == 0:
            return False
        cand.append(row)
    choice = [-1 for i in range(n)]
    picked = [-1 for i in range(n)]
    i = 0
    for tick in range(20000):
        if i == n:
            return True
        if i < 0:
            return False
        choice[i] += 1
        if choice[i] >= len(cand[i]):
            choice[i] = -1
            picked[i] = -1
            i -= 1
            continue
        j = cand[i][choice[i]]
        if j in picked[:i]:
            continue
        ok = True
        for pair in fitok:
            a = pair["a"]
            b = pair["b"]
            if (a == i) and (b < i):
                if not fits_pair_ok(lines[j]["id"], lines[picked[b]]["id"], pair):
                    ok = False
                    break
            if (b == i) and (a < i):
                if not fits_pair_ok(lines[picked[a]]["id"], lines[j]["id"], pair):
                    ok = False
                    break
        if not ok:
            continue
        picked[i] = j
        i += 1
    return False

def cheapest_total(slot, ov, gone):
    total = 0
    for line in slot["tufa"]:
        best = None
        for pid in line["lita"]:
            if pid in gone:
                continue
            c = price_of(slot["fari"], ov, pid) * line["kudi"]
            if (best == None) or (c < best):
                best = c
        if best == None:
            return None
        total += best
    return total

def accepted(slot, lines, reason, key, ov, gone, dyn):
    if reason == "decline":
        if slot.get("nodecline", False):
            return False
        if not dyn:
            return slot["tele"]
        if slot["tele"]:
            return True
        cheapest = cheapest_total(slot, ov, gone)
        return (cheapest == None) or (cheapest > slot["suhe"])
    return lines_claim_answer_lines(lines, slot["tufa"], key, gone, slot.get("fitok", [])) and (order_total(lines, slot["fari"], ov) <= slot["suhe"])

def process_complete(episode, answer, slot, reason):
    opened = {}
    revealed = {}
    for record in episode:
        if record["kind"] == "action":
            tool = record.get("tool")
            args = record.get("args")
            if type(args) != "dict":
                continue
            if tool == "showPage":
                opened[args.get("listingNumber", "")] = True
            elif tool == "matchUpItems":
                ids = args.get("pickedRefs", [])
                if type(ids) == "list":
                    for pid in ids:
                        opened[pid] = True
        elif record["kind"] == "event":
            data = record["data"]
            if (type(data) == "dict") and ("revealed_need" in data):
                revealed[data["revealed_need"]] = True
    # reference chains the request states: every page of the chain opened; a chain whose property the store dropped is waived (slot.refs_off)
    off = slot.get("refs_off", [])
    refs = answer.get("refs", [])
    for k in range(len(refs)):
        if k in off:
            continue
        for item_id in refs[k]:
            if item_id not in opened:
                return False
    if reason == "order":
        # field (9,445 labelled orders, all explained): every hidden need revealed, the chain of a need revealed by reference opened, and every
        # ordered listing opened (showPage / matchUpItems) at some point - a listing put on the order list off a huntListings row alone is process-missed
        for chain in answer.get("need_refs", []):
            for item_id in chain:
                if item_id not in opened:
                    return False
        for label in range(answer.get("needs", 0)):
            if label not in revealed:
                return False
        for line in episode[-1]["order"]["lines"]:
            if line["id"] not in opened:
                return False
    return True

def grade(episode, answer):
    last = episode[-1]
    reason = last["reason"]
    if (reason != "order") and (reason != "decline"):
        return {"category": "did not finish", "score": 0}
    lines = last["order"]["lines"] if (reason == "order") else []
    ov = {}
    gone = []
    mask = 0
    for record in episode:
        if record["kind"] == "event":
            data = record["data"]
            if (type(data) == "dict") and ("situ" in data):
                mask = mask + [1, 2, 4, 8, 16, 32][data["situ"]]
                if data.get("item") != None:
                    if data.get("price_to") != None:
                        ov[data["item"]] = data["price_to"]
                    if data.get("kind") == "stock":
                        gone.append(data["item"])
    fired = mask != 0
    dova = answer["dova"]
    slot = dova[mask] if mask < len(dova) else dova[0]
    dyn = bool(answer.get("dynamic", False))
    if reason == "order":
        # field: a decline is never process-missed (0 of 1,655 released declines)
        if not process_complete(episode, answer, slot, reason):
            return {"category": "process requirement missed", "score": 0}
    jufuli = slot["jufuli"]
    if slot.get("cheapest", False) and ((len(gone) > 0) or (len(ov) > 0)):
        # the store sold out or repriced a listing: the lowest total is the cheapest acceptable basket LEFT, never below the slot's own figure
        left = cheapest_total(slot, ov, gone)
        if (left != None) and (left > jufuli):
            jufuli = left
    verdict = 1 if accepted(slot, lines, reason, "lita", ov, gone, dyn and fired) else 0
    if (verdict == 1) and (reason == "order") and (order_total(lines, slot["fari"], ov) > jufuli):
        verdict = 2
    if (verdict == 1) and (reason == "order"):
        ranked = False
        for line in slot["tufa"]:
            if "best" in line:
                ranked = True
        if ranked:
            # "Of those that fit, I would favour the one with the biggest length": an acceptable line outside the best set is a not-the-best-option order
            best_lines = [{"kudi": line["kudi"], "best": line.get("best", line["lita"])} for line in slot["tufa"]]
            if not lines_claim_answer_lines(lines, best_lines, "best", gone, slot.get("fitok", [])):
                verdict = 2
    if verdict == 1:
        return {"category": None, "score": 1}
    # race 19 has no `changes missed` label (0 of 11,250 episodes): an order the store's price move pushed over the cap is `request not met`.
    # The sold-out branch of races 17 / 18 is kept for a sell-out event (none in this pack).
    if (reason == "order") and lines_claim_answer_lines(lines, slot["tufa"], "lita", [], slot.get("fitok", [])):
        for line in lines:
            if line["id"] in gone:
                return {"category": "changes missed", "score": 0}
    if verdict == 2:
        return {"category": "not the best option", "score": 0}
    return {"category": "request not met", "score": 0}

