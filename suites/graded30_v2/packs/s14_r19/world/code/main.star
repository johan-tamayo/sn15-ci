# Race-19 Starlark World (`s14_r19`, 45 Open Tasks, `w-forge-s14-r19`)
# Reproduces the Race-19 mechanics seen in the released open episodes:
#   * 8 tools: huntListings (search), closeTask (checkout | no_order), set (place adds / release subtracts one line), balanceNow, bagList, message,
#     showPage (full card), matchUpItems (batch view, 1..5 ids)
#   * huntListings: the marks ( ) , - . : ; | of findQ read as spaces, the first 6 words, OR over the analyzed terms, the matches in tiers by the sum of the idf of the terms they hold
#     (BM25 k1 0), each tier in ascending listing id, top 200, 3 rows from the row offset rowStart (0..21), onward = rowStart + 3 while more rows
#     remain and rowStart + 3 <= 21
#   * cards are dicts; facts and shop_good_to_know only on showPage / matchUpItems (split view)
#   * 2-message allowance (message cost 1, budget 2); balanceNow shows the message meter
#   * events: triggers first_add (first set that leaves a line) | after_reveal (first need revealed) | finish (first closeTask); kinds budget | drop | price;
#     everything not yet fired fires at the first close; the notice echoes on the next call as {muso, voboni}
#   * persona: 12 reveal frames; a message about two or more of the task's subjects gets the one-at-a-time pool; one off-need pool per task
#     (no-preference, or did-not-understand on dnu_default tasks)
#   * message credit: race 19's own told / one-at-a-time / off-need table by message shape, two PRNG draws per message (fit: runs/r19_forge/credit_model_r19.json)
#   * graded: every need revealed, every chain page and every ordered listing opened via showPage / matchUpItems, one answer slot per fired-event bitmask

TEXT_INDEX = "jasu"
CATEGORY_INDEX = "nemogi"
BRAND_INDEX = "kojefe"
PAGE_ROWS = 3
MAX_LEAD = 21
TEXT_HITS_CAP = 200  # the field's `num_hits_count` saturates at 200
LINE_MAX = 9  # field: a line over 9 is refused (E81), the schema's itemUnits maximum
ALL_TERMS = False
TOKEN_FOLLOWS_LIVE = False
TROUBLE_REF = "E80"
TROUBLE_EMPTY = "E80"
TROUBLE_LINE = "E81"
TOOLS = ["huntListings", "closeTask", "set", "balanceNow", "bagList", "message", "showPage", "matchUpItems"]

def start(envelope):
    params = envelope["params"]
    for name in TOOLS:
        set_cost(name, "steps", 1)
    set_budget("steps", params.get("step_budget", 43))
    msg_cap = params.get("message_budget", 2)
    set_cost("message", "messages", 1)
    set_budget("messages", msg_cap)
    state_set("message_budget", msg_cap)
    state_set("events", params.get("events", []))
    state_set("fired_idx", [])
    state_set("fired_step", [])
    state_set("pending", [])
    state_set("voiced", [])
    state_set("ov_price", {})
    state_set("gone", [])
    state_set("messages_used", 0)
    state_set("questions_used", 0)
    state_set("last_cart_step", 0)
    state_set("last_cart_sig", "")
    state_set("first_hold_step", 0)
    state_set("first_answer_step", 0)
    setup_shopper(params["bezifa"])
    state_set("credit_seed", rand_below(1000000007))  # the question-credit draws of this episode
    return None

def row_of(item_id):
    return catalog_get(item_id)

def eff_price(row):
    ov = state_get("ov_price", {})
    if row["id"] in ov:
        return ov[row["id"]]
    return row.get("price", 0)

def eff_stock(row):
    if row["id"] in state_get("gone", []):
        return False
    return row.get("in_stock")

def turn():
    return None

# ---------------------------------------------------------------- store events
def needs_target(event):
    return event["kind"] in ["stock", "price"]

def fire_one(i, item, step):
    # event i happens (to the held listing `item` when it needs one; None there: the event is void - consumed with no effect); its echo is queued for the next call
    events = state_get("events", [])
    event = events[i]
    ov = state_get("ov_price", {})
    gone = state_get("gone", [])
    price_to = None
    if item != None:
        row = row_of(item)
        if event["kind"] == "price":
            base = ov.get(item, row.get("price", 0))
            price_to = (base * event["pct"]) // 100  # the live store floors: 409 -> 437 at 107, 532 -> 335 at 63
            ov[item] = price_to
        elif event["kind"] == "stock":
            if item not in gone:
                gone.append(item)
    state_set("ov_price", ov)
    state_set("gone", gone)
    fired = state_get("fired_idx", [])
    fired.append(i)
    state_set("fired_idx", fired)
    fs = state_get("fired_step", [])
    fs.append([i, step])
    state_set("fired_step", fs)
    ledger_append({"situ": i, "item": item if needs_target(event) else None, "kind": event["kind"], "step": step, "price_to": price_to, "silent": not event.get("echo", False)})
    if event.get("echo", False):
        pend = state_get("pending", [])
        pend.append([step, i])
        state_set("pending", pend)

def fire_trigger(trigger):
    # first_add: at the first set that leaves a line in the order list; after_reveal: at the first need revealed
    events = state_get("events", [])
    lines = basket_get()
    step = counters()["step"]
    for i in range(len(events)):
        if (i in state_get("fired_idx", [])) or (events[i].get("trigger", "finish") != trigger):
            continue
        item = None
        if len(lines) > 0:
            item = lines[0]["id"]
        if needs_target(events[i]) and (item == None):
            continue
        fire_one(i, item, step)

def step_fired(i):
    for p in state_get("fired_step", []):
        if p[0] == i:
            return p[1]
    return -1

def can_finish(order):
    events = state_get("events", [])
    if len(events) == 0:
        return {"observation": None, "ok": True}
    is_skip = (type(order) == "dict") and (order.get("kind") == "decline")
    step = counters()["step"]
    lines = basket_get()
    sentences = []
    for i in range(len(events)):
        event = events[i]
        if i in state_get("fired_idx", []):
            # field: an event that fired on the call right before the close (a set, a reveal) is listed in the refusal (t-3000bb2393: the first-hold
            # budget notice x3, with the price sentence after it); an event a refused close already listed is not listed again (4,224 of 4,226
            # closes right after a refused close go through)
            if (step_fired(i) == step - 1) and (i not in state_get("voiced", [])) and not (needs_target(event) and is_skip):
                sentences.append(event["sent"])
                state_set("voiced", state_get("voiced", []) + [i])
            continue
        # everything not yet fired fires at the first close
        if needs_target(event) and (is_skip or (len(lines) == 0)):
            # no held line to hit (no_order, or an empty order list): void - not in the refusal, never retried, still echoed when it echoes (field:
            # 9 + 8 empty no_order closes on the price-only tasks t-9b739985da / t-df78a030c3 go through; t-ac3aa1448e no_order with a line held and
            # t-37c647e036 / t-3000bb2393 empty no_order: the refusal lists the budget sentence alone, the next call carries budget + price)
            fire_one(i, None, step)
            state_set("voiced", state_get("voiced", []) + [i])
            continue
        item = None
        if len(lines) > 0:
            item = lines[0]["id"]
        fire_one(i, item, step)
        sentences.append(event["sent"])
        state_set("voiced", state_get("voiced", []) + [i])
    if len(sentences) > 0:
        return {"observation": sentences, "ok": False}
    return {"observation": None, "ok": True}

def pending_wrap(result):
    pend = state_get("pending", [])
    step = counters()["step"]
    ready = [p for p in pend if p[0] < step]
    if ready:
        state_set("pending", [p for p in pend if p[0] >= step])
        events = state_get("events", [])
        # field: a wrapped message carries the bare reply string in `muso` (89 str), not {"value": ...}
        inner = result["value"] if ((type(result) == "dict") and (len(result) == 1) and ("value" in result)) else result
        return {"muso": inner, "voboni": [events[p[1]]["sent"] for p in ready]}
    return result

# ---------------------------------------------------------------- tools
def desc_of(row):
    text = row.get("description")
    if type(text) != "string":
        return ""
    return text

def row_obj(row, full):
    out = {
        "brand": row.get("maker"),
        "catalog_product_id": row.get("id"),
        "category": row.get("category"),
        "charge": eff_price(row),
        "in_stock": eff_stock(row),
        "listing_label": row.get("title"),
        "narrative": desc_of(row),
        "seller": row.get("merchant"),
    }
    if full:
        facts = row.get("facts")
        out["facts"] = facts if type(facts) == "dict" else {}
        out["shop_good_to_know"] = row.get("seller_notes_text")
    return out

QUERY_SPLIT = "(),-.:;|"  # the marks the live store reads as spaces in the search words (fit: runs/r19_forge/search_fit_r19.json)
QUERY_WORDS = 6  # how many words it reads (0 = every word)

def clean_query(query):
    buf = ""
    for ch in query.elems():
        buf += " " if ch in QUERY_SPLIT else ch
    words = buf.split()
    if QUERY_WORDS > 0:
        words = words[:QUERY_WORDS]
    return " ".join(words)

def text_search_ids(query):
    query = clean_query(query)
    if query == "":
        return []
    found = search(TEXT_INDEX, query, {"all_terms": ALL_TERMS, "k": 1000})
    if found["ok"] == False:
        return []
    out = []
    # the live store lists the matches in tiers: the sum of the idf of the query terms a listing holds (the index scores with bm25 k1 0), each
    # tier in ascending listing id - the order the index returns
    for hit in found["hits"]:
        if row_of(hit["id"]) != None:
            out.append(hit["id"])
    return out[:TEXT_HITS_CAP]

def count_key(query):
    return clean_query(query).lower()

def tool_hunt_listings(args):
    words = str(args.get("findQ", "")).strip()
    lead = args.get("rowStart")
    if lead == None:
        lead = 0
    ids = text_search_ids(words) if words != "" else []
    count = len(ids)
    live = LOCATE_LIVE_COUNT.get(count_key(words))
    if (live != None) and (live > count):
        count = live  # the live store holds listings no field page showed: the recorded `num_hits_count` of this search
    if count > TEXT_HITS_CAP:
        count = TEXT_HITS_CAP
    rows = ids[lead:lead + PAGE_ROWS]
    # live: a next offset while rowStart + 3 < num_hits_count and rowStart + 3 <= 21. The pack holds only listings some field page showed, so where
    # the live count runs past its own rows the offset follows the live count only when TOKEN_FOLLOWS_LIVE (off: it never leads to a page the pack cannot fill)
    reach = count if TOKEN_FOLLOWS_LIVE else len(ids)
    onward = (lead + PAGE_ROWS) if ((lead + PAGE_ROWS < reach) and (lead + PAGE_ROWS <= MAX_LEAD)) else None
    return {"matches": [row_obj(row_of(i), False) for i in rows], "num_hits_count": count, "onward": onward}

def tool_show_page(args):
    row = row_of(args.get("listingNumber", ""))
    if row == None:
        return {"issue_text": TROUBLE_REF}
    return row_obj(row, True)

def tool_match_up_items(args):
    cards = []
    unknown = []
    seen = []
    for pid in args.get("pickedRefs", []):
        if pid in seen:
            continue  # field: an id asked twice is shown once (5 of 5 calls)
        seen.append(pid)
        row = row_of(pid)
        if row == None:
            unknown.append(pid)  # field: an id the store does not hold is listed in ids_unknown, the others are shown (123 calls)
            continue
        cards.append(row_obj(row, True))
    return {"ids_unknown": unknown, "matches": cards}

def line_qty(pid):
    for ln in basket_get():
        if ln["id"] == pid:
            return ln["quantity"]
    return 0

def bag_summary():
    lines_out = []
    total = 0
    for line in basket_get():
        row = row_of(line["id"])
        price = eff_price(row)
        total += price * line["quantity"]
        lines_out.append({"catalog_product_id": line["id"], "charge": price, "listing_label": row.get("title"), "pieces_total": line["quantity"]})
    return {"grand_total_total": total, "selection": lines_out}

def tool_bag_list(args):
    return bag_summary()

def tool_set_line(args):
    pid = args.get("productNumber", "")
    if row_of(pid) == None:
        return {"issue_text": TROUBLE_REF}  # field: an id the store does not hold -> E80 (place and release alike, 191 calls), the order list is unchanged
    kind = args.get("verbKind")
    amount = args.get("itemUnits")
    if amount == None:
        amount = 1  # field: no itemUnits = one (249 places add 1; 887 releases take one off)
    before = line_qty(pid)
    if kind == "release":
        after = before - amount
        if after < 0:
            after = 0  # field: release never goes below 0 (1 held, release 9 -> 0); a listing not held answers pieces_total 0
    else:
        after = before + amount  # field: place ADDS to the line (328 of 328 places on a held line)
        if after > LINE_MAX:
            return {"issue_text": TROUBLE_LINE}  # field: a line over 9 -> E81 (12 of 12), the order list is unchanged
    if after != before:
        basket_set(pid, after)
    sig_parts = []
    for ln in basket_get():
        sig_parts.append(ln["id"] + ":" + str(ln["quantity"]))
    new_sig = ",".join(sorted(sig_parts))
    step = counters()["step"]
    prev_sig = state_get("last_cart_sig", "")
    if new_sig != prev_sig:
        state_set("last_cart_step", step)
        state_set("last_cart_sig", new_sig)
    first = (state_get("first_hold_step", 0) == 0) and (len(sig_parts) > 0)
    if first:
        state_set("first_hold_step", step)
    ledger_append({"cart_change_step": step, "changed_sig": new_sig != prev_sig, "sig": new_sig})
    if first:
        fire_trigger("first_add")
    return {"catalog_product_id": pid, "pieces_total": after}

def tool_close_task(args):
    if args.get("variant") == "no_order":
        request_decline()
        return {"success_flag": True}
    lines = basket_get()
    if len(lines) == 0:
        return {"issue_text": TROUBLE_EMPTY}  # field: a checkout on an empty order list -> E80 (228 of 228); no event fires on it
    request_order(lines)
    return {"success_flag": True}

def tool_message_user(args):
    state_set("messages_used", state_get("messages_used", 0) + 1)
    return {"value": send_message(args.get("textText", ""))}

def tool_balance_now(args):
    used = state_get("messages_used", 0)
    left = state_get("message_budget", 2) - used
    if left < 0:
        left = 0
    return {"virase": {"consumed_count": used, "leftover": left}}

def call(handler, args):
    return pending_wrap({
        "hunt_listings": tool_hunt_listings,
        "show_page": tool_show_page,
        "match_up_items": tool_match_up_items,
        "set_line": tool_set_line,
        "bag_list": tool_bag_list,
        "close_task": tool_close_task,
        "message_user": tool_message_user,
        "balance_now": tool_balance_now,
    }[handler](args))

# ---------------------------------------------------------------- shopper
def setup_shopper(behaviour):
    state_set("behaviour", behaviour)
    state_set("revealed", [])
    subjects = len(behaviour["duno"])
    order = list(range(subjects))
    for i in range(subjects - 1):
        j = i + rand_below(subjects - i)
        tmp = order[i]
        order[i] = order[j]
        order[j] = tmp
    marker = "".join(["PSL39FKNYXC7ZMB8JU6RTGQEW42D5H"[rand_below(30)] for k in range(12)])
    answers = dict(behaviour["vovafo"])
    for i in range(subjects):
        answers[behaviour["melugo"][i]] = behaviour["ligubo"][order[i]]
    prompt = behaviour["meba"] + "\n".join([(behaviour["melugo"][i] + ": ") + behaviour["duno"][order[i]] for i in range(subjects)]) + behaviour["fase"] + marker + "\n"
    state_set("shopper", {"answers": answers, "prompt": prompt, "marker": marker})

def det_idx(text_low, mod):
    if mod <= 0:
        return 0
    h = 0
    for i in range(len(text_low)):
        c = text_low[i]
        h = (h * 31 + len(c) + i) % 1000003
    for w in text_low.split(" "):
        h = (h * 17 + len(w)) % 1000003
    return h % mod

def has_line_word(text_low, words):
    if not words:
        return True
    for w in words:
        if w in text_low:
            return True
    return False

def has_any_line_word(text_low, lwords):
    if not lwords:
        return True
    for key in lwords:
        if has_line_word(text_low, lwords[key]):
            return True
    return False

def is_approval_or_note(text_low):
    if ("nothing is in the cart" in text_low) or ("could not find a " in text_low) or ("noted:" in text_low) or ("sorry for the confusion" in text_low) or ("i was asking" in text_low) or ("i am asking" in text_low) or ("i will ask one question" in text_low) or ("will not wait for your answer" in text_low):
        return False
    cues = [
        "final basket", "basket before", "your basket", "the basket", "in the basket", "current basket",
        "the cart", "your cart", "in the cart", "selection holds", "basket holds", "cart holds",
        "here is the basket", "here's the basket", "placing the order", "place the order", "buying it now", "buying now",
        "shall i order", "shall i place", "shall i buy",
        "before i place", "before i order", "before i buy", "before i finish", "before ordering", "ready to order", "total before ordering",
        "order total", "cart total", "your total is", "total:", "total is ", "total comes to ",
        "may i place", "is it all right to order", "reply yes", "confirm", "approve",
    ]
    for c in cues:
        if c in text_low:
            return True
    if "?" not in text_low:
        return True
    return False

def off_pool(behaviour):
    # race 19: one off-need pool per task besides the one-at-a-time pool (per task the field's other non-reveal replies are no-preference or
    # did-not-understand, never a mix: 5,392 + 5,391 replies, 2 off their task's pool)
    return behaviour["sase"][0] if bool(behaviour.get("dnu_default", False)) else behaviour["sase"][1]

def non_slot_reply(behaviour, text_low):
    pool = off_pool(behaviour)
    return pool[det_idx(text_low, len(pool))]

def ack_reply(behaviour, text_low, step, dnu_default):
    ledger_append({"ack_step": step, "last_cart_step": state_get("last_cart_step", 0)})
    if state_get("first_answer_step", 0) == 0:
        state_set("first_answer_step", step)
    pool = off_pool(behaviour)
    return pool[det_idx(text_low, len(pool))]

def message(text):
    behaviour = state_get("behaviour")
    shopper = state_get("shopper")
    step = counters()["step"]
    text_low = text.lower()
    dnu_default = bool(behaviour.get("dnu_default", False))

    # a note with no question mark is answered from the task's off-need pool without the labeler; one WITH a question mark is put to the labeler first
    approval = is_approval_or_note(text_low)
    if approval and ("?" not in text_low):
        return ack_reply(behaviour, text_low, step, dnu_default)

    cleaned = text
    for k in range(len(text)):
        if shopper["marker"] not in cleaned:
            break
        cleaned = "".join(cleaned.split(shopper["marker"]))
    lwords = behaviour.get("line_words", {})
    is_multi_line = "line1" in lwords
    label = -2
    for s in behaviour["kubono"]:
        if "meza" in s:
            decided = decide_label(behaviour, s, text)
            if decided != None:
                label = decided[0]
                break
        else:
            if is_multi_line and (not has_any_line_word(text_low, lwords)):
                label = -2
                break
            reply = model_call(s["rahi"], (((shopper["prompt"] + cleaned) + "\n") + shopper["marker"]) + behaviour["sufe"], s["gutubi"])
            label = shopper["answers"].get(reply["text"].strip(), -2) if reply["ok"] else -2
            if label != -2:
                break
    if approval and (label < 0) and (label != -3):
        return ack_reply(behaviour, text_low, step, dnu_default)

    state_set("questions_used", state_get("questions_used", 0) + 1)
    ledger_append({"question_step": step})
    if state_get("first_answer_step", 0) == 0:
        state_set("first_answer_step", step)
    if label == -3:
        # two or more of the task's subjects in one message: the shopper asks for one at a time
        ledger_append({"one_at_a_time_step": step})
        pool = behaviour["tugo"]
        return pool[det_idx(text_low, len(pool))]
    if label >= 0:
        first_reveal = len(state_get("revealed")) == 0
        if label not in state_get("revealed"):
            state_set("revealed", state_get("revealed") + [label])
            ledger_append({"revealed_need": label})
            if first_reveal:
                fire_trigger("after_reveal")
        pool = behaviour["sase"][label + 2]
        return pool[det_idx(text_low, len(pool))]
    return non_slot_reply(behaviour, text_low)

def decide_label(behaviour, step, text):
    reply = model_decide(step["rahi"], {"message": text}, behaviour["botisi"], step["gutubi"])
    if not reply["ok"]:
        return None
    answers = reply["answers"]
    if (type(answers) == "dict") and ("answers" in answers):
        answers = answers["answers"]
    if type(answers) != "dict":
        return None
    scores = {}
    for key in behaviour["botisi"]:
        item = answers.get(key)
        if (type(item) != "dict") or (type(item.get("noul")) not in ["float", "int"]):
            return None
        value = item["noul"]
        if ((value < 0) or (value > 1)) or ((value > step["devizu"]) and (value < step["meza"])):
            return None
        scores[key] = value
    if scores[behaviour["jekaro"]] >= step["meza"]:
        return [-1]
    text_low = text.lower()
    lwords = behaviour.get("line_words", {})
    raw_hits = [key for key in behaviour["viroju"] if (scores[key] >= step["meza"])]
    return [credit_decide(behaviour, text, raw_hits)]  # race 19: the fitted told / one-at-a-time / off-need draw of the message's cell (runs/r19_forge/credit_model_r19.json)

# ---------------------------------------------------------------- question credit (race-19 fit: runs/r19_forge/credit_model_r19.json; the parser is FORGE4's)
CREDIT_INTERROGATIVES = ["what ", "which "]
CREDIT_WANT_FOR = ["want for ", "like for ", "need for ", "want on ", "want in ", "need in ", "care about ", "looking for ", "want from ", "need from ", "want ", "need "]
CREDIT_PREFERENCE = ["preference for the ", "preference for ", "preferences for ", "preference on ", "prefer "]
CREDIT_CUTS = [" would you", " do you", " should ", " for the ", " for your ", " for my ", " for a ", " for an ", " for this ", " of the ", " on the ", " in the ", " for example", " such as", " e.g.", " like ", " please", " so i ", " so that ", " - "]
CREDIT_SEPS = [",", ";", " or ", " and ", " / "]
# joiners that also list names ("material & colour", "size/fit"); searched on a copy with the task's item words blanked
CREDIT_JOINERS = ["&", "+", "/", "\n", " plus ", " as well as ", " along with ", " together with ", " nor ", " versus ", " vs "]

def credit_draw(idx):
    x = (state_get("credit_seed", 0) * 2654435761 + idx * 40503 + 12345) % 4294967296
    x = ((x ^ (x >> 16)) * 2246822519) % 4294967296
    x = ((x ^ (x >> 13)) * 3266489917) % 4294967296
    x = x ^ (x >> 16)
    return x % 10000

def credit_span_end(ql, start):
    end = ql.find("?", start)
    if end < 0:
        end = len(ql)
    lo = start - 1
    if lo < 0:
        lo = 0
    for cut in CREDIT_CUTS:
        j = ql.find(cut, lo, end)
        if (j >= 0) and (j < end):
            end = j
            if end < start:
                end = start
    return end

def credit_last_marker(ql, markers, lo, hi):
    best = -1
    for m in markers:
        i = ql.rfind(m, lo, hi)
        if (i >= 0) and (i + len(m) > best):
            best = i + len(m)
    return best

def credit_split_span(ql, start, end, masked = None):
    parts = []
    pos = start
    for n in range(64):
        best = -1
        blen = 0
        for sep in CREDIT_SEPS:
            j = ql.find(sep, pos, end)
            if (j >= 0) and ((best < 0) or (j < best)):
                best = j
                blen = len(sep)
        if masked != None:
            for sep in CREDIT_JOINERS:
                j = masked.find(sep, pos, end)
                if (j >= 0) and ((best < 0) or (j < best)):
                    best = j
                    blen = len(sep)
        if best < 0:
            break
        parts.append([pos, best])
        pos = best + blen
    parts.append([pos, end])
    return [p for p in parts if ql[p[0]:p[1]].strip() != ""]

def credit_name_span(ql, masked = None):
    # after the last interrogative before the first '?' (a colon after it wins when its list has more separators); if that span is
    # empty ("what do you want for ..."), after the last "want for"-type phrase after the interrogative; without an interrogative,
    # after a "preference for"-type phrase, else a colon, else the text start
    q_end = ql.find("?")
    if q_end < 0:
        q_end = len(ql)
    si = credit_last_marker(ql, CREDIT_INTERROGATIVES, 0, q_end)
    if si >= 0:
        ei = credit_span_end(ql, si)
        if ql[si:ei].strip() != "":
            c = ql.rfind(":", si, q_end)
            if c >= 0:
                ec = credit_span_end(ql, c + 1)
                if len(credit_split_span(ql, c + 1, ec, masked)) > len(credit_split_span(ql, si, ei, masked)):
                    return [c + 1, ec]
            return [si, ei]
        sw = credit_last_marker(ql, CREDIT_WANT_FOR, si, q_end)
        if sw >= 0:
            return [sw, credit_span_end(ql, sw)]
        c = ql.rfind(":", si, q_end)
        if c >= 0:
            return [c + 1, credit_span_end(ql, c + 1)]
        return [si, ei]
    sp = credit_last_marker(ql, CREDIT_PREFERENCE, 0, q_end)
    if sp >= 0:
        return [sp, credit_span_end(ql, sp)]
    c = ql.rfind(":", 0, q_end)
    if c >= 0:
        return [c + 1, credit_span_end(ql, c + 1)]
    return [0, credit_span_end(ql, 0)]

def credit_mask_items(ql, behaviour):
    masked = ql
    lwords = behaviour.get("line_words", {})
    for key in lwords:
        for w in lwords[key]:
            wl = str(w).lower()
            blank = wl
            for sep in CREDIT_JOINERS:
                blank = blank.replace(sep, " " * len(sep))
            if (wl == "") or (blank == wl):
                continue
            pos = 0
            for n in range(64):
                i = ql.find(wl, pos)
                if i < 0:
                    break
                masked = masked[:i] + blank + masked[i + len(wl):]
                pos = i + len(wl)
    return masked

def credit_name_parts(ql, behaviour = None):
    masked = None if behaviour == None else credit_mask_items(ql, behaviour)
    span = credit_name_span(ql, masked)
    return credit_split_span(ql, span[0], span[1], masked)

def credit_tokens(ql):
    out = []
    cur = ""
    start = -1
    for i in range(len(ql)):
        ch = ql[i]
        if ch.isalnum():
            if start < 0:
                start = i
            cur += ch
        else:
            if start >= 0:
                out.append([start, cur])
            cur = ""
            start = -1
    if start >= 0:
        out.append([start, cur])
    return out

def credit_stems(prop):
    words = []
    cur = ""
    for ch in prop.lower().elems():
        if ch.isalnum():
            cur += ch
        else:
            if cur != "":
                words.append(cur)
            cur = ""
    if cur != "":
        words.append(cur)
    return [(w[:-1] if (len(w) > 1 and w.endswith("s")) else w) for w in words]

def credit_phrase_span(toks, prop):
    st = credit_stems(prop)
    if len(st) == 0:
        return None
    for i in range(len(toks) - len(st) + 1):
        ok = True
        for j in range(len(st)):
            t = toks[i + j][1]
            if (t != st[j]) and (t != st[j] + "s"):
                ok = False
                break
        if ok:
            return [i, len(st)]
    return None

def credit_phrase_pos(toks, prop):
    sp = credit_phrase_span(toks, prop)
    if sp == None:
        return -1
    return toks[sp[0]][0]

def credit_shelf_matches(toks, lwords, own_words):
    # [own, other]: a line's shelf word present as a phrase (each token with an optional plural s); a match inside a LONGER
    # match of another line does not count ("phone case" inside "samsung galaxy phone case")
    found = []
    for lk in lwords:
        if not lk.startswith("line"):
            continue
        is_own = lwords[lk] == own_words
        for w in lwords[lk]:
            sp = credit_phrase_span(toks, w)
            if sp != None:
                found.append([sp[0], sp[1], is_own])
    own = False
    other = False
    for f in found:
        dominated = False
        for g in found:
            if (g[2] != f[2]) and (g[1] > f[1]) and (g[0] <= f[0]) and (f[0] + f[1] <= g[0] + g[1]):
                dominated = True
        if not dominated:
            if f[2]:
                own = True
            else:
                other = True
    return [own, other]

