# Race-24 Starlark World (`s14_r24`, 45 Open Tasks, `w-forge-s14-r24`)
# Reproduces the Race-24 mechanics seen in the released open episodes:
#   * 7 tools: InspectItem (the card string), BagSummary, WrapUpRequest (buy | abstain), AskShopper, AddItem (insert | release ONE line),
#     LookupListings (keyword search), ScreenShelf (filter listing: ItemSection / Vendor / CostPriceMax)
#   * LookupListings: the marks ( ) , - . : ; | of freeQ read as spaces, words under 2 characters skipped, the first 4 words, AND over their analyzed terms, n_results capped at 200;
#     ScreenShelf: the section's listings (any case; or, with no section, the brand's) in ascending id, Vendor = the brand, CostPriceMax =
#     the highest unit price let through; neither section nor vendor -> {}. 10 rows from the token's offset; next_page = "zasu<offset + 10>"
#     while more rows remain; a token that is not "zasu<N>" -> {}
#   * rows and cards are strings; shop_good_to_know and facts only on InspectItem
#   * 3-message allowance (AskShopper cost 1, budget 3)
#   * events: triggers first_add (first AddItem that leaves a line) | after_reveal (first need revealed) | finish (first WrapUpRequest);
#     kinds budget | drop | stock (the first held listing sells out) | price; everything not yet fired fires at the first close; the notice
#     echoes on the next call as {gefa, nifu}
#   * persona: 12 reveal frames; one off-need pool per task (no-preference, or did-not-understand on dnu_default tasks); no one-at-a-time pool
#   * message credit: race 24's own told share by the place of the first need a message names and the names it carries
#     (fit: runs/r24_forge/credit_model_r24.json)
#   * graded: every need revealed, every chain page and every ordered listing opened (InspectItem), one answer slot per fired-event bitmask

TEXT_INDEX = "jasu"
CATEGORY_INDEX = "nemogi"
BRAND_INDEX = "kojefe"
PAGE_ROWS = 10
TEXT_HITS_CAP = 200  # the field's n_results of a keyword search saturates at 200
LINE_MAX = 5  # field: an insert that would take a line from 3 to 6 units -> {fault: E38}
ALL_TERMS = False
TOKEN_FOLLOWS_LIVE = False
TOKEN_PREFIX = "zasu"
NO_ORDER = "E39"
LINE_OVER = "E38"
TOOLS = ["InspectItem", "BagSummary", "WrapUpRequest", "AskShopper", "AddItem", "LookupListings", "ScreenShelf"]

def start(envelope):
    params = envelope["params"]
    for name in TOOLS:
        set_cost(name, "steps", 1)
    set_budget("steps", params.get("step_budget", 40))
    msg_cap = params.get("message_budget", 3)
    set_cost("AskShopper", "messages", 1)
    set_budget("messages", msg_cap)
    state_set("message_budget", msg_cap)
    state_set("events", params.get("events", []))
    state_set("fired_idx", [])
    state_set("fired_step", [])
    state_set("pending", [])
    state_set("voiced", [])
    state_set("ov_price", {})
    state_set("gone", [])
    state_set("messages_used", 0)
    state_set("questions_used", 0)
    state_set("last_cart_step", 0)
    state_set("last_cart_sig", "")
    state_set("first_hold_step", 0)
    state_set("first_answer_step", 0)
    setup_shopper(params["bezifa"])
    state_set("credit_seed", rand_below(1000000007))  # the question-credit draws of this episode
    return None

def row_of(item_id):
    return catalog_get(item_id)

def eff_price(row):
    ov = state_get("ov_price", {})
    if row["id"] in ov:
        return ov[row["id"]]
    return row.get("price", 0)

def eff_stock(row):
    if row["id"] in state_get("gone", []):
        return False
    return row.get("in_stock")

def turn():
    return None

# ---------------------------------------------------------------- store events
def needs_target(event):
    return event["kind"] in ["stock", "price"]

def fire_one(i, item, step):
    # event i happens (to the held listing `item` when it needs one; None there: the event is void - consumed with no effect); its echo is queued for the next call
    events = state_get("events", [])
    event = events[i]
    ov = state_get("ov_price", {})
    gone = state_get("gone", [])
    price_to = None
    if item != None:
        row = row_of(item)
        if event["kind"] == "price":
            base = ov.get(item, row.get("price", 0))
            price_to = (base * event["pct"]) // 100  # the live store floors (races 18-20; the builder replays every field price move with the same rule)
            ov[item] = price_to
        elif event["kind"] == "stock":
            if item not in gone:
                gone.append(item)
    state_set("ov_price", ov)
    state_set("gone", gone)
    fired = state_get("fired_idx", [])
    fired.append(i)
    state_set("fired_idx", fired)
    fs = state_get("fired_step", [])
    fs.append([i, step])
    state_set("fired_step", fs)
    ledger_append({"situ": i, "item": item if needs_target(event) else None, "kind": event["kind"], "step": step, "price_to": price_to, "silent": not event.get("echo", False)})
    if event.get("echo", False):
        pend = state_get("pending", [])
        pend.append([step, i])
        state_set("pending", pend)

def fire_trigger(trigger):
    # first_add: at the first StashToCart that leaves a line in the order list; after_reveal: at the first need revealed
    events = state_get("events", [])
    lines = basket_get()
    step = counters()["step"]
    for i in range(len(events)):
        if (i in state_get("fired_idx", [])) or (events[i].get("trigger", "finish") != trigger):
            continue
        item = None
        if len(lines) > 0:
            item = lines[0]["id"]
        if needs_target(events[i]) and (item == None):
            continue
        fire_one(i, item, step)

def step_fired(i):
    for p in state_get("fired_step", []):
        if p[0] == i:
            return p[1]
    return -1

def can_finish(order):
    events = state_get("events", [])
    if len(events) == 0:
        return {"observation": None, "ok": True}
    is_skip = (type(order) == "dict") and (order.get("kind") == "decline")
    step = counters()["step"]
    lines = basket_get()
    sentences = []
    for i in range(len(events)):
        event = events[i]
        if i in state_get("fired_idx", []):
            # an event that fired on the call right before the close (a StashToCart, a reveal) is listed in the refusal; an event a refused
            # close already listed is not listed again
            if (step_fired(i) == step - 1) and (i not in state_get("voiced", [])) and not (needs_target(event) and is_skip):
                sentences.append(event["sent"])
                state_set("voiced", state_get("voiced", []) + [i])
            continue
        # everything not yet fired fires at the first close
        if needs_target(event) and (is_skip or (len(lines) == 0)):
            # no held line to hit (cancel, or an empty order list): void - not in the refusal, never retried, still echoed when it echoes
            fire_one(i, None, step)
            state_set("voiced", state_get("voiced", []) + [i])
            continue
        item = None
        if len(lines) > 0:
            item = lines[0]["id"]
        fire_one(i, item, step)
        sentences.append(event["sent"])
        state_set("voiced", state_get("voiced", []) + [i])
    if len(sentences) > 0:
        return {"observation": sentences, "ok": False}
    return {"observation": None, "ok": True}

def pending_wrap(result):
    pend = state_get("pending", [])
    step = counters()["step"]
    ready = [p for p in pend if p[0] < step]
    if ready:
        state_set("pending", [p for p in pend if p[0] >= step])
        events = state_get("events", [])
        # field: a wrapped AskShopper / InspectItem carries the bare string in `gefa`, not {"value": ...}
        inner = result["value"] if ((type(result) == "dict") and (len(result) == 1) and ("value" in result)) else result
        return {"gefa": inner, "nifu": [events[p[1]]["sent"] for p in ready]}
    return result

# ---------------------------------------------------------------- tools
def desc_of(row):
    text = row.get("description")
    if type(text) != "string":
        return ""
    return text

def show(v):
    if v == None:
        return "None"
    return str(v)

def row_text(row, full):
    # live: `key: value` pairs joined by " | " in a fixed order; the card adds shop_good_to_know after the merchant and facts before desc
    parts = ["listing_id_code: " + row.get("id"), "listing_headline: " + show(row.get("title")), "listing_merchant: " + show(row.get("merchant"))]
    if full:
        parts.append("shop_good_to_know: " + show(row.get("seller_notes_text")))
    parts.append("manufacturer: " + show(row.get("maker")))
    parts.append("unit_price: " + str(eff_price(row)))
    parts.append("on_hand: " + str(eff_stock(row)))
    parts.append("category: " + show(row.get("category")))
    if full:
        facts = row.get("facts_text")
        parts.append("facts: " + (facts if type(facts) == "string" else ""))
    parts.append("desc: " + desc_of(row))
    return " | ".join(parts)

QUERY_SPLIT = "(),-.:;|"  # the marks the live store reads as spaces in the search words (fit: runs/r24_forge/search_fit_r24.json)
QUERY_WORDS = 4  # how many words it reads (0 = every word)
QUERY_MINLEN = 2  # words shorter than this are skipped before the count

def clean_query(query):
    buf = ""
    for ch in query.elems():
        buf += " " if ch in QUERY_SPLIT else ch
    words = [w for w in buf.split() if len(w) >= QUERY_MINLEN]
    if QUERY_WORDS > 0:
        words = words[:QUERY_WORDS]
    return " ".join(words)

def text_search_ids(query):
    query = clean_query(query)
    if query == "":
        return []
    found = search(TEXT_INDEX, query, {"all_terms": ALL_TERMS, "k": 1000})
    if found["ok"] == False:
        return []
    out = []
    for hit in found["hits"]:
        if row_of(hit["id"]) != None:
            out.append(hit["id"])
    # the live store ranks the matches by BM25 (equal scores in id order, the index's own order)
    return out[:TEXT_HITS_CAP]

def count_key(query):
    return clean_query(query).lower()

def criteria_ids(group, make):
    # the filter listing: the section's listings in ascending id (the shelf name as the store writes it, case ignored; an unknown name
    # lists nothing), narrowed to the brand when Vendor is given; with no section, the brand's listings over the whole store
    if group != None:
        ids = AISLE_IDS.get(str(group).lower(), [])
        if make != None:
            ids = [i for i in ids if row_of(i).get("maker") == make]
        return ids
    out = []
    for name in AISLE_IDS:
        for i in AISLE_IDS[name]:
            if row_of(i).get("maker") == make:
                out.append(i)
    return sorted(out)

def criteria_key(group, make, limit):
    return "|".join([str(group).lower() if group != None else "", str(make) if make != None else "", str(limit) if limit != None else ""])

def lead_of(token):
    # the page token: absent -> 0; "zasu<N>" -> N; anything else -> -1 (the store answers {})
    if token == None:
        return 0
    t = str(token)
    if t.startswith(TOKEN_PREFIX) and t[len(TOKEN_PREFIX):].isdigit():
        return int(t[len(TOKEN_PREFIX):])
    return -1

def page_of(ids, count, lead):
    rows = ids[lead:lead + PAGE_ROWS]
    reach = count if TOKEN_FOLLOWS_LIVE else len(ids)
    if reach > TEXT_HITS_CAP:
        reach = TEXT_HITS_CAP
    nxt = (TOKEN_PREFIX + str(lead + PAGE_ROWS)) if (lead + PAGE_ROWS < reach) else None
    return {"n_results": count, "next_page": nxt, "outcomes": [row_text(row_of(i), False) for i in rows]}

def tool_lookup_listings(args):
    lead = lead_of(args.get("After"))
    if lead < 0:
        return {}
    words = str(args.get("TextString") or "").strip()
    ids = text_search_ids(words) if words != "" else []
    count = len(ids)
    live = LOCATE_LIVE_COUNT.get(count_key(words))
    if (live != None) and (live > count):
        count = live  # the live store holds listings no field page showed: the recorded n_results of this search
    if count > TEXT_HITS_CAP:
        count = TEXT_HITS_CAP
    return page_of(ids, count, lead)

def tool_screen_shelf(args):
    lead = lead_of(args.get("Token"))
    group = args.get("ItemSection")
    make = args.get("Vendor")
    if (lead < 0) or ((group == None) and (make == None)):
        return {}  # field: a bad token, or a filter with neither a section nor a vendor (CostPriceMax alone does not count)
    ids = criteria_ids(group, make)
    limit = args.get("CostPriceMax")
    if limit != None:
        ids = [i for i in ids if eff_price(row_of(i)) <= limit]  # field: CostPriceMax is the highest unit price let through
    count = len(ids)
    live = CRITERIA_LIVE_COUNT.get(criteria_key(group, make, limit))
    if (live != None) and (live > count):
        count = live  # the live shelf holds listings no field page showed
    return page_of(ids, count, lead)

def tool_inspect_item(args):
    row = row_of(args.get("ListingIdKey", ""))
    if row == None:
        return {}  # field: an id the store does not hold
    return {"value": row_text(row, True)}

def bag_summary():
    lines_out = []
    total = 0
    for line in basket_get():
        row = row_of(line["id"])
        price = eff_price(row)
        total += price * line["quantity"]
        lines_out.append({"item_qty": line["quantity"], "listing_headline": row.get("title"), "listing_id_code": line["id"], "unit_price": price})
    return {"bag_items": lines_out, "cart_subtotal": total}

def tool_bag_summary(args):
    return bag_summary()

def tool_add_item(args):
    pid = args.get("ItemNumber", "")
    if row_of(pid) == None:
        return {}  # an id the store does not hold: the trolley is unchanged
    units = args.get("QtyWanted")
    if units == None:
        units = 1  # field: a bare insert adds one unit, a bare release takes one away
    have = 0
    for ln in basket_get():
        if ln["id"] == pid:
            have = ln["quantity"]
    if args.get("CartOperation") == "insert":
        if have + units > LINE_MAX:
            return {"fault": LINE_OVER}  # field: an insert taking a line from 3 to 6 units
        basket_set(pid, have + units)
    else:
        left = have - units
        basket_set(pid, left if left > 0 else 0)  # a release never goes below 0; releasing a line not held answers ok
    sig_parts = []
    for ln in basket_get():
        sig_parts.append(ln["id"] + ":" + str(ln["quantity"]))
    new_sig = ",".join(sorted(sig_parts))
    step = counters()["step"]
    prev_sig = state_get("last_cart_sig", "")
    if new_sig != prev_sig:
        state_set("last_cart_step", step)
        state_set("last_cart_sig", new_sig)
    first = (state_get("first_hold_step", 0) == 0) and (len(sig_parts) > 0)
    if first:
        state_set("first_hold_step", step)
    ledger_append({"cart_change_step": step, "changed_sig": new_sig != prev_sig, "sig": new_sig})
    if first:
        fire_trigger("first_add")
    return {"success_flag": True}

def tool_wrap_up_request(args):
    if args.get("SearchBy") == "abstain":
        request_decline()
        return {"success_flag": True}
    lines = basket_get()
    if len(lines) == 0:
        return {"fault": NO_ORDER}  # field: buy on an empty trolley; no event fires on it
    request_order(lines)
    return {"success_flag": True}

def tool_ask_shopper(args):
    state_set("messages_used", state_get("messages_used", 0) + 1)
    return {"value": send_message(args.get("ReplyMsg", ""))}

def call(handler, args):
    return pending_wrap({
        "lookup_listings": tool_lookup_listings,
        "screen_shelf": tool_screen_shelf,
        "inspect_item": tool_inspect_item,
        "add_item": tool_add_item,
        "bag_summary_tool": tool_bag_summary,
        "wrap_up_request": tool_wrap_up_request,
        "ask_shopper": tool_ask_shopper,
    }[handler](args))

# ---------------------------------------------------------------- shopper
def setup_shopper(behaviour):
    state_set("behaviour", behaviour)
    state_set("revealed", [])
    subjects = len(behaviour["duno"])
    order = list(range(subjects))
    for i in range(subjects - 1):
        j = i + rand_below(subjects - i)
        tmp = order[i]
        order[i] = order[j]
        order[j] = tmp
    marker = "".join(["PSL39FKNYXC7ZMB8JU6RTGQEW42D5H"[rand_below(30)] for k in range(12)])
    answers = dict(behaviour["vovafo"])
    for i in range(subjects):
        answers[behaviour["melugo"][i]] = behaviour["ligubo"][order[i]]
    prompt = behaviour["meba"] + "\n".join([(behaviour["melugo"][i] + ": ") + behaviour["duno"][order[i]] for i in range(subjects)]) + behaviour["fase"] + marker + "\n"
    state_set("shopper", {"answers": answers, "prompt": prompt, "marker": marker})

def det_idx(text_low, mod):
    if mod <= 0:
        return 0
    h = 0
    for i in range(len(text_low)):
        c = text_low[i]
        h = (h * 31 + len(c) + i) % 1000003
    for w in text_low.split(" "):
        h = (h * 17 + len(w)) % 1000003
    return h % mod

def has_line_word(text_low, words):
    if not words:
        return True
    for w in words:
        if w in text_low:
            return True
    return False

def has_any_line_word(text_low, lwords):
    if not lwords:
        return True
    for key in lwords:
        if has_line_word(text_low, lwords[key]):
            return True
    return False

def is_approval_or_note(text_low):
    if ("nothing is in the cart" in text_low) or ("could not find a " in text_low) or ("noted:" in text_low) or ("sorry for the confusion" in text_low) or ("i was asking" in text_low) or ("i am asking" in text_low) or ("i will ask one question" in text_low) or ("will not wait for your answer" in text_low):
        return False
    cues = [
        "final basket", "basket before", "your basket", "the basket", "in the basket", "current basket",
        "the cart", "your cart", "in the cart", "selection holds", "basket holds", "cart holds",
        "here is the basket", "here's the basket", "placing the order", "place the order", "buying it now", "buying now",
        "shall i order", "shall i place", "shall i buy",
        "before i place", "before i order", "before i buy", "before i finish", "before ordering", "ready to order", "total before ordering",
        "order total", "cart total", "your total is", "total:", "total is ", "total comes to ",
        "may i place", "is it all right to order", "reply yes", "confirm", "approve",
    ]
    for c in cues:
        if c in text_low:
            return True
    if "?" not in text_low:
        return True
    return False

def off_pool(behaviour):
    # race 21: one off-need pool per task besides the one-at-a-time pool (per task the field's other non-reveal replies are no-preference or
    # did-not-understand)
    return behaviour["sase"][0] if bool(behaviour.get("dnu_default", False)) else behaviour["sase"][1]

def non_slot_reply(behaviour, text_low):
    pool = off_pool(behaviour)
    return pool[det_idx(text_low, len(pool))]

def ack_reply(behaviour, text_low, step, dnu_default):
    ledger_append({"ack_step": step, "last_cart_step": state_get("last_cart_step", 0)})
    if state_get("first_answer_step", 0) == 0:
        state_set("first_answer_step", step)
    pool = off_pool(behaviour)
    return pool[det_idx(text_low, len(pool))]

def message(text):
    behaviour = state_get("behaviour")
    shopper = state_get("shopper")
    step = counters()["step"]
    text_low = text.lower()
    dnu_default = bool(behaviour.get("dnu_default", False))

    # a note with no question mark is answered from the task's off-need pool without the labeler; one WITH a question mark is put to the labeler first
    approval = is_approval_or_note(text_low)
    if approval and ("?" not in text_low):
        return ack_reply(behaviour, text_low, step, dnu_default)

    cleaned = text
    for k in range(len(text)):
        if shopper["marker"] not in cleaned:
            break
        cleaned = "".join(cleaned.split(shopper["marker"]))
    lwords = behaviour.get("line_words", {})
    is_multi_line = "line1" in lwords
    label = -2
    subjects_hit = 1
    for s in behaviour["kubono"]:
        if "meza" in s:
            decided = decide_label(behaviour, s, text)
            if decided != None:
                label = decided[0]
                if len(decided) > 1:
                    subjects_hit = decided[1]
                break
        else:
            if is_multi_line and (not has_any_line_word(text_low, lwords)):
                label = -2
                break
            reply = model_call(s["rahi"], (((shopper["prompt"] + cleaned) + "\n") + shopper["marker"]) + behaviour["sufe"], s["gutubi"])
            label = shopper["answers"].get(reply["text"].strip(), -2) if reply["ok"] else -2
            if label != -2:
                break
    if approval and (label < 0) and ((label != -3) or (subjects_hit == 0)):
        # a note or an approval request (`... shall I place the order?`): answered from the off-need pool - unless the reader hit two
        # or more of the shopper's subjects in it (then it is pushed back like any message)
        return ack_reply(behaviour, text_low, step, dnu_default)

    state_set("questions_used", state_get("questions_used", 0) + 1)
    ledger_append({"question_step": step})
    if state_get("first_answer_step", 0) == 0:
        state_set("first_answer_step", step)
    if (label == -3) and (len(behaviour.get("tugo", [])) > 0):
        # the shopper reads the message as several questions: it asks for one at a time (race 24 has no such pool: the off-need reply)
        ledger_append({"one_at_a_time_step": step})
        pool = behaviour["tugo"]
        return pool[det_idx(text_low, len(pool))]
    if label >= 0:
        first_reveal = len(state_get("revealed")) == 0
        if label not in state_get("revealed"):
            state_set("revealed", state_get("revealed") + [label])
            ledger_append({"revealed_need": label})
            if first_reveal:
                fire_trigger("after_reveal")
        pool = behaviour["sase"][label + 2]
        return pool[det_idx(text_low, len(pool))]
    return non_slot_reply(behaviour, text_low)

def decide_label(behaviour, step, text):
    reply = model_decide(step["rahi"], {"message": text}, behaviour["botisi"], step["gutubi"])
    if not reply["ok"]:
        return None
    answers = reply["answers"]
    if (type(answers) == "dict") and ("answers" in answers):
        answers = answers["answers"]
    if type(answers) != "dict":
        return None
    scores = {}
    for key in behaviour["botisi"]:
        item = answers.get(key)
        if (type(item) != "dict") or (type(item.get("noul")) not in ["float", "int"]):
            return None
        value = item["noul"]
        if ((value < 0) or (value > 1)) or ((value > step["devizu"]) and (value < step["meza"])):
            return None
        scores[key] = value
    if scores[behaviour["jekaro"]] >= step["meza"]:
        return [-1]
    raw_hits = [key for key in behaviour["viroju"] if (scores[key] >= step["meza"])]
    # no hit does not end the message here: credit_decide answers a list of names in which the reader finds no subject from its own cell
    # (pushed back now and then, as the live shopper did) and anything else with -2
    return [credit_decide(behaviour, text, raw_hits), len(raw_hits)]  # race 24: the fitted told / pushed-back shares of the message's cell (runs/r24_forge/credit_model_r24.json)

# ---------------------------------------------------------------- question credit (race-21 fit: runs/r24_forge/credit_model_r24.json)
# Race 21's shopper turns back a message it reads as several questions.  The cell of a message - the first need the reader hit, its place
# among the names of the message, the names carried, first or later question, the item it is asked with, and whether the reader hit one
# subject or several - gives [told, pushed back]; a message that hits only subjects the shopper has no view on has a cell of its own.
# Two draws per message from the episode PRNG seed and the message index (told, then one at a time); the table is fitted on every released
# race-21 question (credit_fit_r24.py).  The block is valid Python as well: the fit and `sn15 s-expected-told` execute it as it stands.
