# Race-21 Starlark World (`s14_r21`, 45 Open Tasks, `w-forge-s14-r21`)
# Reproduces the Race-21 mechanics seen in the released open episodes:
#   * 7 tools: Examine (full card), ListingsSearch (phrase = keyword search | criteria = filter listing), SummaryBag, StashToCart (the list
#     REPLACES the order list), SummaryBalance (message meter), BuyerAsk, OrderWrapUp (commit | cancel)
#   * ListingsSearch SearchWay phrase: the marks ( ) , - . : ; | of FindTerms read as spaces, every word, AND over the analyzed terms, the matches in ascending listing id, top 200
#     (Aisle, ProductMake and LimitLimit are not read); SearchWay criteria: the Aisle's listings (or, with no Aisle, the brand's) in
#     ascending id, ProductMake = the brand, LimitLimit = the highest unit price let through (FindTerms is not read; neither Aisle nor
#     ProductMake -> {}); 7 rows from SkipRows, page_next_token = SkipRows + 7 while more rows remain and SkipRows + 7 <= 56
#   * cards are dicts; facts and remarks_section only on Examine (split view)
#   * 2-message allowance (BuyerAsk cost 1, budget 2); SummaryBalance shows the message meter
#   * events: triggers first_add (first StashToCart that leaves a line) | after_reveal (first need revealed) | finish (first OrderWrapUp);
#     kinds budget | drop | price; everything not yet fired fires at the first close; the notice echoes on the next call as {tezazu, vaza}
#   * persona: 12 reveal frames; a ONE-AT-A-TIME pool for a message the shopper reads as several questions; one off-need pool per task
#     (no-preference, or did-not-understand on dnu_default tasks)
#   * message credit: race 21's own told and pushed-back shares by the place of the first need a message names and the names it carries
#     (fit: runs/r21_forge/credit_model_r21.json)
#   * graded: every need revealed, every chain page and every ordered listing opened via Examine, one answer slot per fired-event bitmask

TEXT_INDEX = "jasu"
CATEGORY_INDEX = "nemogi"
BRAND_INDEX = "kojefe"
PAGE_ROWS = 7
MAX_LEAD = 56  # the schema's SkipRows maximum; the live store hands out no token past it (field: 7 rows at SkipRows 56 with more matches and no token)
TEXT_HITS_CAP = 200  # the field's `found_number` of a keyword search saturates at 200
ALL_TERMS = True
TOKEN_FOLLOWS_LIVE = False
TROUBLE_EMPTY = "EMPTY"
TOOLS = ["Examine", "ListingsSearch", "SummaryBag", "StashToCart", "SummaryBalance", "BuyerAsk", "OrderWrapUp"]

def start(envelope):
    params = envelope["params"]
    for name in TOOLS:
        set_cost(name, "steps", 1)
    set_budget("steps", params.get("step_budget", 35))
    msg_cap = params.get("message_budget", 2)
    set_cost("BuyerAsk", "messages", 1)
    set_budget("messages", msg_cap)
    state_set("message_budget", msg_cap)
    state_set("events", params.get("events", []))
    state_set("fired_idx", [])
    state_set("fired_step", [])
    state_set("pending", [])
    state_set("voiced", [])
    state_set("ov_price", {})
    state_set("gone", [])
    state_set("messages_used", 0)
    state_set("questions_used", 0)
    state_set("last_cart_step", 0)
    state_set("last_cart_sig", "")
    state_set("first_hold_step", 0)
    state_set("first_answer_step", 0)
    setup_shopper(params["bezifa"])
    state_set("credit_seed", rand_below(1000000007))  # the question-credit draws of this episode
    return None

def row_of(item_id):
    return catalog_get(item_id)

def eff_price(row):
    ov = state_get("ov_price", {})
    if row["id"] in ov:
        return ov[row["id"]]
    return row.get("price", 0)

def eff_stock(row):
    if row["id"] in state_get("gone", []):
        return False
    return row.get("in_stock")

def turn():
    return None

# ---------------------------------------------------------------- store events
def needs_target(event):
    return event["kind"] in ["stock", "price"]

def fire_one(i, item, step):
    # event i happens (to the held listing `item` when it needs one; None there: the event is void - consumed with no effect); its echo is queued for the next call
    events = state_get("events", [])
    event = events[i]
    ov = state_get("ov_price", {})
    gone = state_get("gone", [])
    price_to = None
    if item != None:
        row = row_of(item)
        if event["kind"] == "price":
            base = ov.get(item, row.get("price", 0))
            price_to = (base * event["pct"]) // 100  # the live store floors (races 18-20; the builder replays every field price move with the same rule)
            ov[item] = price_to
        elif event["kind"] == "stock":
            if item not in gone:
                gone.append(item)
    state_set("ov_price", ov)
    state_set("gone", gone)
    fired = state_get("fired_idx", [])
    fired.append(i)
    state_set("fired_idx", fired)
    fs = state_get("fired_step", [])
    fs.append([i, step])
    state_set("fired_step", fs)
    ledger_append({"situ": i, "item": item if needs_target(event) else None, "kind": event["kind"], "step": step, "price_to": price_to, "silent": not event.get("echo", False)})
    if event.get("echo", False):
        pend = state_get("pending", [])
        pend.append([step, i])
        state_set("pending", pend)

def fire_trigger(trigger):
    # first_add: at the first StashToCart that leaves a line in the order list; after_reveal: at the first need revealed
    events = state_get("events", [])
    lines = basket_get()
    step = counters()["step"]
    for i in range(len(events)):
        if (i in state_get("fired_idx", [])) or (events[i].get("trigger", "finish") != trigger):
            continue
        item = None
        if len(lines) > 0:
            item = lines[0]["id"]
        if needs_target(events[i]) and (item == None):
            continue
        fire_one(i, item, step)

def step_fired(i):
    for p in state_get("fired_step", []):
        if p[0] == i:
            return p[1]
    return -1

def can_finish(order):
    events = state_get("events", [])
    if len(events) == 0:
        return {"observation": None, "ok": True}
    is_skip = (type(order) == "dict") and (order.get("kind") == "decline")
    step = counters()["step"]
    lines = basket_get()
    sentences = []
    for i in range(len(events)):
        event = events[i]
        if i in state_get("fired_idx", []):
            # an event that fired on the call right before the close (a StashToCart, a reveal) is listed in the refusal; an event a refused
            # close already listed is not listed again
            if (step_fired(i) == step - 1) and (i not in state_get("voiced", [])) and not (needs_target(event) and is_skip):
                sentences.append(event["sent"])
                state_set("voiced", state_get("voiced", []) + [i])
            continue
        # everything not yet fired fires at the first close
        if needs_target(event) and (is_skip or (len(lines) == 0)):
            # no held line to hit (cancel, or an empty order list): void - not in the refusal, never retried, still echoed when it echoes
            fire_one(i, None, step)
            state_set("voiced", state_get("voiced", []) + [i])
            continue
        item = None
        if len(lines) > 0:
            item = lines[0]["id"]
        fire_one(i, item, step)
        sentences.append(event["sent"])
        state_set("voiced", state_get("voiced", []) + [i])
    if len(sentences) > 0:
        return {"observation": sentences, "ok": False}
    return {"observation": None, "ok": True}

def pending_wrap(result):
    pend = state_get("pending", [])
    step = counters()["step"]
    ready = [p for p in pend if p[0] < step]
    if ready:
        state_set("pending", [p for p in pend if p[0] >= step])
        events = state_get("events", [])
        # field: a wrapped BuyerAsk carries the bare reply string in `vaza`, not {"value": ...}
        inner = result["value"] if ((type(result) == "dict") and (len(result) == 1) and ("value" in result)) else result
        return {"tezazu": [events[p[1]]["sent"] for p in ready], "vaza": inner}
    return result

# ---------------------------------------------------------------- tools
def desc_of(row):
    text = row.get("description")
    if type(text) != "string":
        return ""
    return text

def row_obj(row, full):
    out = {
        "brand": row.get("maker"),
        "description": desc_of(row),
    }
    if full:
        facts = row.get("facts")
        out["facts"] = facts if type(facts) == "dict" else {}
    out["item_id_code"] = row.get("id")
    out["label_line"] = row.get("title")
    out["merchant"] = row.get("merchant")
    out["product_shelf"] = row.get("category")
    out["ready"] = eff_stock(row)
    if full:
        out["remarks_section"] = row.get("seller_notes_text")
    out["unit_list_price"] = eff_price(row)
    return out

QUERY_SPLIT = "(),-.:;|"  # the marks the live store reads as spaces in the search words (fit: runs/r21_forge/search_fit_r21.json)
QUERY_WORDS = 0  # how many words it reads (0 = every word)

def clean_query(query):
    buf = ""
    for ch in query.elems():
        buf += " " if ch in QUERY_SPLIT else ch
    words = buf.split()
    if QUERY_WORDS > 0:
        words = words[:QUERY_WORDS]
    return " ".join(words)

def text_search_ids(query):
    query = clean_query(query)
    if query == "":
        return []
    found = search(TEXT_INDEX, query, {"all_terms": ALL_TERMS, "k": 1000})
    if found["ok"] == False:
        return []
    out = []
    for hit in found["hits"]:
        if row_of(hit["id"]) != None:
            out.append(hit["id"])
    # the live store lists the matches in ascending listing id (the index scores every match the same: bm25 k1 0)
    return sorted(out)[:TEXT_HITS_CAP]

def count_key(query):
    return clean_query(query).lower()

def criteria_ids(aisle, make):
    # the filter style: the Aisle's listings in ascending id (the name as the store writes it, case ignored; an unknown name lists nothing),
    # narrowed to the brand when ProductMake is given; with no Aisle, the brand's listings over the whole store
    if aisle != None:
        ids = AISLE_IDS.get(str(aisle).lower(), [])
        if make != None:
            ids = [i for i in ids if row_of(i).get("maker") == make]
        return ids
    out = []
    for name in AISLE_IDS:
        for i in AISLE_IDS[name]:
            if row_of(i).get("maker") == make:
                out.append(i)
    return sorted(out)

def criteria_key(aisle, make, limit):
    return "|".join([str(aisle).lower() if aisle != None else "", str(make) if make != None else "", str(limit) if limit != None else ""])

def tool_listings_search(args):
    lead = args.get("SkipRows")
    if lead == None:
        lead = 0
    way = args.get("SearchWay")
    ids = []
    count = 0
    if way == "criteria":
        aisle = args.get("Aisle")
        make = args.get("ProductMake")
        if (aisle == None) and (make == None):
            return {}  # field: a filter search with neither an aisle nor a brand answers an empty object (FindTerms / LimitLimit alone do not count)
        ids = criteria_ids(aisle, make)
        limit = args.get("LimitLimit")
        if limit != None:
            ids = [i for i in ids if eff_price(row_of(i)) <= limit]  # field: LimitLimit is the highest unit price let through, not a page size
        count = len(ids)
        live = CRITERIA_LIVE_COUNT.get(criteria_key(aisle, make, limit))
        if (live != None) and (live > count):
            count = live  # the live aisle holds listings no field page showed
    else:
        # field: the keyword search; Aisle, ProductMake and LimitLimit are not read; no words -> nothing
        words = str(args.get("FindTerms") or "").strip()
        ids = text_search_ids(words) if words != "" else []
        count = len(ids)
        live = LOCATE_LIVE_COUNT.get(count_key(words))
        if (live != None) and (live > count):
            count = live  # the live store holds listings no field page showed: the recorded `found_number` of this search
        if count > TEXT_HITS_CAP:
            count = TEXT_HITS_CAP
    rows = ids[lead:lead + PAGE_ROWS]
    # live: a token while SkipRows + 7 < found_number and SkipRows + 7 <= 56. The pack holds only listings some field page showed, so where
    # the live count runs past its own rows the token follows the live count only when TOKEN_FOLLOWS_LIVE (off: it never leads to a page
    # the pack cannot fill)
    reach = count if TOKEN_FOLLOWS_LIVE else len(ids)
    token = (lead + PAGE_ROWS) if ((lead + PAGE_ROWS < reach) and (lead + PAGE_ROWS <= MAX_LEAD)) else None
    return {"found_number": count, "outcomes": [row_obj(row_of(i), False) for i in rows], "page_next_token": token}

def tool_examine(args):
    row = row_of(args.get("TargetItem", ""))
    if row == None:
        return {}  # field: an id the store does not hold answers an empty object
    return row_obj(row, True)

def bag_summary():
    lines_out = []
    total = 0
    for line in basket_get():
        row = row_of(line["id"])
        price = eff_price(row)
        total += price * line["quantity"]
        lines_out.append({"item_id_code": line["id"], "label_line": row.get("title"), "unit_list_price": price, "units": line["quantity"]})
    return {"basket_lines": lines_out, "owed": total}

def tool_summary_bag(args):
    return bag_summary()

def tool_stash_to_cart(args):
    wanted = {}
    order = []
    for entry in args.get("Stuff", []):
        pid = entry.get("Ref", "")
        if row_of(pid) == None:
            return {"issue_text": "BAD_REF"}  # an id the store does not hold: the order list is unchanged
        if pid not in wanted:
            order.append(pid)
        wanted[pid] = entry.get("N", 1)  # a repeated id keeps its first position and its last amount
    for ln in basket_get():
        basket_set(ln["id"], 0)
    for pid in order:
        if wanted[pid] > 0:
            basket_set(pid, wanted[pid])  # field: the list REPLACES the order list (every recorded answer is the list sent, in its order)
    sig_parts = []
    for ln in basket_get():
        sig_parts.append(ln["id"] + ":" + str(ln["quantity"]))
    new_sig = ",".join(sorted(sig_parts))
    step = counters()["step"]
    prev_sig = state_get("last_cart_sig", "")
    if new_sig != prev_sig:
        state_set("last_cart_step", step)
        state_set("last_cart_sig", new_sig)
    first = (state_get("first_hold_step", 0) == 0) and (len(sig_parts) > 0)
    if first:
        state_set("first_hold_step", step)
    ledger_append({"cart_change_step": step, "changed_sig": new_sig != prev_sig, "sig": new_sig})
    if first:
        fire_trigger("first_add")
    return bag_summary()

def tool_order_wrap_up(args):
    if args.get("WayChoice") == "cancel":
        request_decline()
        return {"accepted_flag": True}
    lines = basket_get()
    if len(lines) == 0:
        return {"issue_text": TROUBLE_EMPTY}  # field: a commit on an empty order list -> EMPTY; no event fires on it
    request_order(lines)
    return {"accepted_flag": True}

def tool_buyer_ask(args):
    state_set("messages_used", state_get("messages_used", 0) + 1)
    return {"value": send_message(args.get("Text", ""))}

def tool_summary_balance(args):
    used = state_get("messages_used", 0)
    left = state_get("message_budget", 2) - used
    if left < 0:
        left = 0
    return {"duzova": {"points_burned": used, "unspent_count": left}}

def call(handler, args):
    return pending_wrap({
        "listings_search": tool_listings_search,
        "examine": tool_examine,
        "stash_to_cart": tool_stash_to_cart,
        "summary_bag": tool_summary_bag,
        "order_wrap_up": tool_order_wrap_up,
        "buyer_ask": tool_buyer_ask,
        "summary_balance": tool_summary_balance,
    }[handler](args))

# ---------------------------------------------------------------- shopper
def setup_shopper(behaviour):
    state_set("behaviour", behaviour)
    state_set("revealed", [])
    subjects = len(behaviour["duno"])
    order = list(range(subjects))
    for i in range(subjects - 1):
        j = i + rand_below(subjects - i)
        tmp = order[i]
        order[i] = order[j]
        order[j] = tmp
    marker = "".join(["PSL39FKNYXC7ZMB8JU6RTGQEW42D5H"[rand_below(30)] for k in range(12)])
    answers = dict(behaviour["vovafo"])
    for i in range(subjects):
        answers[behaviour["melugo"][i]] = behaviour["ligubo"][order[i]]
    prompt = behaviour["meba"] + "\n".join([(behaviour["melugo"][i] + ": ") + behaviour["duno"][order[i]] for i in range(subjects)]) + behaviour["fase"] + marker + "\n"
    state_set("shopper", {"answers": answers, "prompt": prompt, "marker": marker})

def det_idx(text_low, mod):
    if mod <= 0:
        return 0
    h = 0
    for i in range(len(text_low)):
        c = text_low[i]
        h = (h * 31 + len(c) + i) % 1000003
    for w in text_low.split(" "):
        h = (h * 17 + len(w)) % 1000003
    return h % mod

def has_line_word(text_low, words):
    if not words:
        return True
    for w in words:
        if w in text_low:
            return True
    return False

def has_any_line_word(text_low, lwords):
    if not lwords:
        return True
    for key in lwords:
        if has_line_word(text_low, lwords[key]):
            return True
    return False

def is_approval_or_note(text_low):
    if ("nothing is in the cart" in text_low) or ("could not find a " in text_low) or ("noted:" in text_low) or ("sorry for the confusion" in text_low) or ("i was asking" in text_low) or ("i am asking" in text_low) or ("i will ask one question" in text_low) or ("will not wait for your answer" in text_low):
        return False
    cues = [
        "final basket", "basket before", "your basket", "the basket", "in the basket", "current basket",
        "the cart", "your cart", "in the cart", "selection holds", "basket holds", "cart holds",
        "here is the basket", "here's the basket", "placing the order", "place the order", "buying it now", "buying now",
        "shall i order", "shall i place", "shall i buy",
        "before i place", "before i order", "before i buy", "before i finish", "before ordering", "ready to order", "total before ordering",
        "order total", "cart total", "your total is", "total:", "total is ", "total comes to ",
        "may i place", "is it all right to order", "reply yes", "confirm", "approve",
    ]
    for c in cues:
        if c in text_low:
            return True
    if "?" not in text_low:
        return True
    return False

def off_pool(behaviour):
    # race 21: one off-need pool per task besides the one-at-a-time pool (per task the field's other non-reveal replies are no-preference or
    # did-not-understand)
    return behaviour["sase"][0] if bool(behaviour.get("dnu_default", False)) else behaviour["sase"][1]

def non_slot_reply(behaviour, text_low):
    pool = off_pool(behaviour)
    return pool[det_idx(text_low, len(pool))]

def ack_reply(behaviour, text_low, step, dnu_default):
    ledger_append({"ack_step": step, "last_cart_step": state_get("last_cart_step", 0)})
    if state_get("first_answer_step", 0) == 0:
        state_set("first_answer_step", step)
    pool = off_pool(behaviour)
    return pool[det_idx(text_low, len(pool))]

def message(text):
    behaviour = state_get("behaviour")
    shopper = state_get("shopper")
    step = counters()["step"]
    text_low = text.lower()
    dnu_default = bool(behaviour.get("dnu_default", False))

    # a note with no question mark is answered from the task's off-need pool without the labeler; one WITH a question mark is put to the labeler first
    approval = is_approval_or_note(text_low)
    if approval and ("?" not in text_low):
        return ack_reply(behaviour, text_low, step, dnu_default)

    cleaned = text
    for k in range(len(text)):
        if shopper["marker"] not in cleaned:
            break
        cleaned = "".join(cleaned.split(shopper["marker"]))
    lwords = behaviour.get("line_words", {})
    is_multi_line = "line1" in lwords
    label = -2
    subjects_hit = 1
    for s in behaviour["kubono"]:
        if "meza" in s:
            decided = decide_label(behaviour, s, text)
            if decided != None:
                label = decided[0]
                if len(decided) > 1:
                    subjects_hit = decided[1]
                break
        else:
            if is_multi_line and (not has_any_line_word(text_low, lwords)):
                label = -2
                break
            reply = model_call(s["rahi"], (((shopper["prompt"] + cleaned) + "\n") + shopper["marker"]) + behaviour["sufe"], s["gutubi"])
            label = shopper["answers"].get(reply["text"].strip(), -2) if reply["ok"] else -2
            if label != -2:
                break
    if approval and (label < 0) and ((label != -3) or (subjects_hit == 0)):
        # a note or an approval request (`... shall I place the order?`): answered from the off-need pool - unless the reader hit two
        # or more of the shopper's subjects in it (then it is pushed back like any message)
        return ack_reply(behaviour, text_low, step, dnu_default)

    state_set("questions_used", state_get("questions_used", 0) + 1)
    ledger_append({"question_step": step})
    if state_get("first_answer_step", 0) == 0:
        state_set("first_answer_step", step)
    if label == -3:
        # the shopper reads the message as several questions: it asks for one at a time
        ledger_append({"one_at_a_time_step": step})
        pool = behaviour["tugo"]
        return pool[det_idx(text_low, len(pool))]
    if label >= 0:
        first_reveal = len(state_get("revealed")) == 0
        if label not in state_get("revealed"):
            state_set("revealed", state_get("revealed") + [label])
            ledger_append({"revealed_need": label})
            if first_reveal:
                fire_trigger("after_reveal")
        pool = behaviour["sase"][label + 2]
        return pool[det_idx(text_low, len(pool))]
    return non_slot_reply(behaviour, text_low)

def decide_label(behaviour, step, text):
    reply = model_decide(step["rahi"], {"message": text}, behaviour["botisi"], step["gutubi"])
    if not reply["ok"]:
        return None
    answers = reply["answers"]
    if (type(answers) == "dict") and ("answers" in answers):
        answers = answers["answers"]
    if type(answers) != "dict":
        return None
    scores = {}
    for key in behaviour["botisi"]:
        item = answers.get(key)
        if (type(item) != "dict") or (type(item.get("noul")) not in ["float", "int"]):
            return None
        value = item["noul"]
        if ((value < 0) or (value > 1)) or ((value > step["devizu"]) and (value < step["meza"])):
            return None
        scores[key] = value
    if scores[behaviour["jekaro"]] >= step["meza"]:
        return [-1]
    raw_hits = [key for key in behaviour["viroju"] if (scores[key] >= step["meza"])]
    # no hit does not end the message here: credit_decide answers a list of names in which the reader finds no subject from its own cell
    # (pushed back now and then, as the live shopper did) and anything else with -2
    return [credit_decide(behaviour, text, raw_hits), len(raw_hits)]  # race 21: the fitted told / pushed-back shares of the message's cell (runs/r21_forge/credit_model_r21.json)

# ---------------------------------------------------------------- question credit (race-21 fit: runs/r21_forge/credit_model_r21.json)
# Race 21's shopper turns back a message it reads as several questions.  The cell of a message - the first need the reader hit, its place
# among the names of the message, the names carried, first or later question, the item it is asked with, and whether the reader hit one
# subject or several - gives [told, pushed back]; a message that hits only subjects the shopper has no view on has a cell of its own.
# Two draws per message from the episode PRNG seed and the message index (told, then one at a time); the table is fitted on every released
# race-21 question (credit_fit_r21.py).  The block is valid Python as well: the fit and `sn15 s-expected-told` execute it as it stands.
